                                    Action{text: "取消" + slotNames[m.slot] on_click: || cancel_meal(m.slot)}
                                }
                            }
                        }
                    }
                }
            }
        }}
    }
    status_card := RoundedView{width: Fill height: Fit flow: Down padding: Inset{left: 12 right: 12 top: 8 bottom: 8} show_bg: true draw_bg.color: #xe9ede6 draw_bg.border_radius: 12.0
        status := Label{width: Fill text: "正在启动…" draw_text.color: ink draw_text.text_style.font_size: 12}
    }
    footer_note := Label{width: Fill text: "金额是计划开销，未下单 · 菜单非实时" draw_text.color: muted draw_text.text_style.font_size: 10}
}
