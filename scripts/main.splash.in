let english = false
let ink = #x203d32
let muted = #x697970
let blue = #x315e45

fn L(zh, en){ if english { return en } zh }
fn slot_label(slot){
    if english { let names = ["Breakfast" "Lunch" "Dinner"] return names[slot] }
    slotNames[slot]
}

fn cash(cents){
    if cents < 0 { return "-" + cash(-cents) }
    let whole = floor(cents / 100)
    let tail = cents - whole * 100
    let decimal = "" + tail
    if tail < 10 { decimal = "0" + decimal }
    "" + whole + "." + decimal
}
fn pad(n){ if n < 10 { return "0" + n } "" + n }
fn week_date(start, offset){
    let p = start.split("-")
    let y = p[0].to_f64()
    let m = p[1].to_f64()
    let d = p[2].to_f64()
    for step in offset {
        let days = [31 28 31 30 31 30 31 31 30 31 30 31]
        if y % 4 == 0 && (y % 100 != 0 || y % 400 == 0) { days[1] = 29 }
        d += 1
        if d > days[m - 1] {
            d = 1
            m += 1
            if m > 12 { m = 1 y += 1 }
        }
    }
    "" + y + "-" + pad(m) + "-" + pad(d)
}
fn today(){
    let d = local_time()
    "" + d.year + "-" + pad(d.month) + "-" + pad(d.day)
}
fn valid_date(text){
    if !regex("^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "").test(text) { return false }
    let p = text.split("-")
    let y = p[0].to_f64()
    let m = p[1].to_f64()
    let d = p[2].to_f64()
    if y < 2000 || y > 2100 || m < 1 || m > 12 { return false }
    let monthDays = [31 28 31 30 31 30 31 31 30 31 30 31]
    if y % 4 == 0 && (y % 100 != 0 || y % 400 == 0) { monthDays[1] = 29 }
    d >= 1 && d <= monthDays[m - 1]
}
fn clock_value(text){
    if !regex("^[0-9]{2}:[0-9]{2}$", "").test(text) { return -1 }
    let p = text.split(":")
    let h = p[0].to_f64()
    let m = p[1].to_f64()
    if h >= 24 || m >= 60 { return -1 }
    h * 60 + m
}
fn money_value(text){
    let s = text.trim()
    if !regex("^[0-9]+([.][0-9]{1,2})?$", "").test(s) { return -1 }
    let n = round(s.to_f64() * 100)
    if !(n >= 100 && n <= 50000) { return -1 }
    n
}
fn monthly_value(text){
    let s = text.trim()
    if !regex("^[0-9]+([.][0-9]{1,2})?$", "").test(s) { return -1 }
    let n = round(s.to_f64() * 100)
    if !(n >= 0 && n <= 5000000) { return -1 }
    n
}
fn open_at(hours, current){
    if hours == "" || hours == "未设置" { return false }
    for period in hours.split(",") {
        let parts = period.trim().split("-")
        if parts.len() == 2 {
            let a = clock_value(parts[0].trim())
            let b = clock_value(parts[1].trim())
            if a >= 0 && b >= 0 {
                if a < b && current >= a && current < b { return true }
                if a > b && (current >= a || current < b) { return true }
            }
        }
    }
    false
}
fn matches_meal(p){
    let text = p.name + " " + p.category
    if regex("勿点|专用|补差|打包费|餐具|加料|加粉|加饭|加面|配菜|小料", "").test(text) { return false }
    if selectedSlot == 0 {
        return regex("包子|馒头|粥|肠粉|油条|饺|馄饨|云吞|三明治|鸡蛋|煎蛋", "").test(text)
            && !regex("饮|奶茶|果切|水果|咖啡|甜品|蛋糕|豆浆|牛奶|加料", "").test(text)
    }
    regex("饭|粉|面|米线|馄饨|云吞|饺子|套餐|堡", "").test(text)
        && regex("肉|鸡|鸭|猪|牛|鱼|虾|蛋|肘|排骨|叉烧|云吞|饺|腊|煲仔|麻婆", "").test(p.name)
        && !regex("饮|奶茶|果切|水果|咖啡|甜品|蛋糕|面包|早餐|粥类|豆浆|油条|斋|清汤|青菜|白饭|米饭|单点|小份|半份", "").test(text)
        && p.cents >= 800
}
fn day_index(doc, date){
    for i in doc.days.len() { if doc.days[i].date == date { return i } }
    -1
}
fn current_meals(){
    let i = day_index(journal, currentDate)
    if i < 0 { return [] }
    journal.days[i].meals
}
fn sum_meals(meals, omit){
    let amount = 0
    for m in meals { if m.slot != omit { amount += m.cents } }
    amount
}
fn record_valid(doc){
    if doc.schema != 1 || !(doc.revision >= 1) || doc.revision != floor(doc.revision) || !valid_date(doc.last_date) { return false }
    if doc.days.len() > 90 { return false }
    let dates = []
    for day in doc.days {
        if !valid_date(day.date) || !(day.daily_cents >= 100 && day.daily_cents <= 50000) || day.daily_cents != floor(day.daily_cents) { return false }
        if !(day.tier >= 0 && day.tier < 6) || day.tier != floor(day.tier) || day.meals.len() > 3 { return false }
        for date in dates { if date == day.date { return false } }
        dates.push(day.date)
        let slots = []
        for m in day.meals {
            if !(m.slot >= 0 && m.slot < 3) || m.slot != floor(m.slot) { return false }
            for s in slots { if s == m.slot { return false } }
            slots.push(m.slot)
            if !(m.product_id >= 0 && m.product_id < allProducts.len()) || m.product_id != floor(m.product_id) { return false }
            let product = allProducts[m.product_id]
            if m.cents != product.cents || m.name != product.name || m.store != product.store || m.hours != product.business_hours { return false }
            if clock_value(m.arrival) < 0 || !open_at(m.hours, clock_value(m.arrival)) || m.note.len() > 500 { return false }
            if !(m.saved_at >= 0) { return false }
        }
        if sum_meals(day.meals, -1) > day.daily_cents { return false }
    }
    day_index(doc, doc.last_date) >= 0
}
fn read_record(path){
    let result = nil
    try {
        let parsed = fs.read(path).parse_json()
        if record_valid(parsed) { result = parsed }
    } { result = nil }
    result
}
fn store_record(next){
    if !storageReady {
        ui.status.set_text(L("记录无法读取，已暂停保存。请先恢复有效的计划文件。", "Records cannot be read. Saving is paused until a valid plan file is restored."))
        return false
    }
    next.revision = journal.revision + 1
    let target = "plans-a.json"
    if activeFile == target { target = "plans-b.json" }
    let written = false
    try {
        let text = next.to_json()
        fs.write(target, text)
        if fs.read(target) == text {
            let checked = read_record(target)
            if checked != nil { written = true }
        }
    } { written = false }
    if !written {
        ui.status.set_text(L("保存失败：未能写入并核验。上一份有效计划已保留，请检查存储后重试。", "Save failed verification. The previous valid plan remains; check storage and retry."))
        return false
    }
    journal = next
    activeFile = target
    return true
}
fn hide_candidates(){
    // Invalidate any outstanding assistant callback when its inputs/results
    // cease to be usable. A late callback must not lock a newer request.
    agentRequest += 1
    agentBusy = false
    candidates = []
    candidateStamp = ""
    agentChoice = -1
    agentStamp = ""
    ui.agent_result.set_text(L("先生成候选，再请系统 Agent 比较。", "Find options, then ask the system Agent to compare."))
    ui.choices.render()
}
fn invalidate(){
    hide_candidates()
    homeSkip = -1
    if onHome { show_home() } else { show_page(false) }
    ui.status.set_text(L("条件已变化，请重新查找候选。已保存计划不变。", "Settings changed. Find new options; saved plans are unchanged."))
    refresh_summary()
}
fn selection_stamp(){
    ui.date.text().trim() + "|" + currentDate + "|" + selectedSlot + "|" + ui.daily.text().trim() + "|" + ui.budget.text().trim() + "|" + ui.arrival.text().trim() + "|" + ui.request.text().trim() + "|" + ui.avoid_spicy.checked()
}
