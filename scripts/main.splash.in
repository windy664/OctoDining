                View{width: Fill height: Fit flow: Down spacing: 3
                    budget_heading := Label{text: "本餐上限（元）" draw_text.color: muted draw_text.text_style.font_size: 12}
                    budget := Field{text: "14.00" on_change: |text| invalidate()}
                }
                View{width: Fill height: Fit flow: Down spacing: 3
                    arrival_heading := Label{text: "到店时间" draw_text.color: muted draw_text.text_style.font_size: 12}
                    arrival := Field{text: "18:30" on_change: |text| invalidate()}
                }
            }
            avoid_spicy := CheckBox{text: "关键词避辣（不保证过敏原或辣度）" on_click: |active| invalidate()}
            View{width: Fill height: Fit flow: Right spacing: 8
                find := Action{width: Fill text: "只看候选" on_click: || find_candidates()}
                save_daily := Action{text: "保存日预算" on_click: || save_budget()}
            }
        }
        budget_explain := Label{width: Fill text: "单餐上限与每日总预算同时生效。已有餐次会计入剩余金额。" draw_text.color: muted draw_text.text_style.font_size: 12}
    }
    results := ScrollYView{width: Fill height: Fill flow: Down spacing: 10
        View{width: Fill height: Fit flow: Right spacing: 8
            adjust_conditions := Action{text: "调整条件" on_click: || show_page(false)}
            next_batch := Action{text: "换一批候选" on_click: || find_candidates()}
        }
        dish_search := TextInput{width: Fill height: 40 text: "" empty_text: "搜菜名，如 蒸饺、牛肉 / Search a dish name"
            draw_bg +: {color: #xffffff color_hover: #xffffff color_focus: #xffffff color_empty: #xffffff border_radius: 12.0 border_size: 0.0}
            draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: muted color_empty_hover: muted}}
        Action{text: L("按菜名找", "Search by name") on_click: || { searchCursor = 0 find_candidates() }}
        RoundedView{width: Fill height: Fit flow: Down spacing: 8 padding: Inset{left: 14 right: 14 top: 13 bottom: 13} show_bg: true draw_bg.color: #xe9ede6 draw_bg.border_radius: 16.0
            agent_heading := Label{text: "Agent 的建议" draw_text.color: blue draw_text.text_style: theme.font_bold{font_size: 14}}
            agent_result := Label{width: Fill text: "先生成候选，再请系统 Agent 比较。" draw_text.color: ink draw_text.text_style.font_size: 12}
            View{width: Fill height: Fit flow: Right spacing: 8
                ask_agent := Action{text: "重新请 Agent 比较" on_click: || ask_agent()}
                agent_cancel := Action{text: "取消" visible: false on_click: || cancel_agent()}
            }
        }
        choices := View{width: Fill height: Fit flow: Down spacing: 10 on_render: || {
            if candidates.len() == 0 { Label{width: Fill text: L("填写条件后查找候选。价格和时段来自菜单快照。", "Set your preferences to find options. Prices and hours are from a menu snapshot.") draw_text.color: muted draw_text.text_style.font_size: 13} }
            let recentProductIds = []
            let firstRecentDay = max(0, journal.days.len() - 7)
            for dayIndex in firstRecentDay..journal.days.len() {
                for m in journal.days[dayIndex].meals { recentProductIds.push(m.product_id) }
            }
            for i in candidates.len() {
                let p = allProducts[candidates[i]]
                let cap = money_value(ui.budget.text())
                if cap < 0 { cap = 0 }
                let detailLabel = L("详情 ›", "Details ›")
                if expandedCandidate == i { detailLabel = L("收起 ↑", "Hide ↑") }
                let evidence = L("证据：¥", "Evidence: ¥") + cash(p.cents) + L(" ≤ 本餐上限 ¥", " ≤ meal limit ¥") + cash(cap)
                if open_at(p.business_hours, clock_value(ui.arrival.text().trim())) { evidence += L(" · 到店时段营业中", " · open at arrival") }
                if regex("辣|麻|椒", "").test(p.name + " " + p.category) { evidence += L(" · 菜名含辣味词", " · spicy keyword in name") }
                if !regex("辣|麻|椒", "").test(p.name + " " + p.category) { evidence += L(" · 菜名无辣味词", " · no spicy keyword") }
                let repeated = false
                for id in recentProductIds { if id == candidates[i] { repeated = true } }
                if repeated { evidence += L(" · 近七天吃过", " · eaten in the last 7 days") }
                if !repeated { evidence += L(" · 近七天未吃", " · not eaten recently") }
                RoundedView{width: Fill height: Fit flow: Down spacing: 7 padding: Inset{left: 14 right: 14 top: 12 bottom: 12} show_bg: true draw_bg.color: #xffffff draw_bg.border_radius: 15.0
                    View{width: Fill height: Fit flow: Right spacing: 9
                        View{width: Fill height: Fit flow: Down spacing: 5
                            Label{width: Fill text: p.name + " · ¥" + cash(p.cents) draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                            Label{width: Fill text: p.store + " · " + p.business_hours draw_text.color: muted draw_text.text_style.font_size: 12}
                            Label{width: Fill text: evidence draw_text.color: muted draw_text.text_style.font_size: 10}
                        }
                        if p.image_url != "" { Image{width: 72 height: 72 src: img_src_id(candidates[i]) fit: ImageFit.CropToFill} }
                    }
                    if agentChoice == i && agentStamp == candidateStamp { Label{width: Fill text: L("OctoSense Agent 建议", "OctoSense Agent pick") draw_text.color: blue draw_text.text_style.font_size: 12} }
                    View{width: Fill height: Fit flow: Right spacing: 8
                        Accent{width: Fill text: L("确认候选 ", "Confirm option ") + (i + 1) on_click: || choose_meal(i)}
                        Action{text: detailLabel on_click: || toggle_candidate_detail(i)}
                    }
                }
            }
        }}
        detail_card := RoundedView{width: Fill height: Fit flow: Down spacing: 4 padding: Inset{left: 14 right: 14 top: 11 bottom: 11} show_bg: true draw_bg.color: #xf2f5ee draw_bg.border_radius: 15.0 visible: false
            cd_title := Label{text: "候选详情" draw_text.color: blue draw_text.text_style: theme.font_bold{font_size: 12}}
            cd1 := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style.font_size: 11}
            cd2 := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style.font_size: 11}
            cd3 := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style.font_size: 11}
            cd4 := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style.font_size: 11}
            cd5 := Label{width: Fill text: "" draw_text.color: muted draw_text.text_style.font_size: 10}
        }
    }
    history := ScrollYView{width: Fill height: Fill flow: Down spacing: 10
        week_title := Label{width: Fill text: "我的一周餐表 · 从所选日期起七天" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}}
        View{width: Fill height: Fit flow: Right spacing: 8
            make_draft := Action{text: "生成七天草案" on_click: || generate_week_draft()}
        }
        week_budget_card := RoundedView{width: Fill height: Fit flow: Down spacing: 6 padding: Inset{left: 12 right: 12 top: 10 bottom: 10} show_bg: true draw_bg.color: #xffffff draw_bg.border_radius: 15.0
            week_budget_label := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 12}}
            RoundedView{width: Fill height: 14 padding: Inset{left: 3 right: 3 top: 3 bottom: 3} show_bg: true draw_bg.color: #xe9ede6 draw_bg.border_radius: 7.0 flow: Right spacing: 3
                wb0 := RoundedView{width: 24 height: 8 show_bg: true draw_bg.color: #x244a38 draw_bg.border_radius: 4.0 visible: false}
                wb1 := RoundedView{width: 24 height: 8 show_bg: true draw_bg.color: #x244a38 draw_bg.border_radius: 4.0 visible: false}
                wb2 := RoundedView{width: 24 height: 8 show_bg: true draw_bg.color: #x244a38 draw_bg.border_radius: 4.0 visible: false}
                wb3 := RoundedView{width: 24 height: 8 show_bg: true draw_bg.color: #x244a38 draw_bg.border_radius: 4.0 visible: false}
                wb4 := RoundedView{width: 24 height: 8 show_bg: true draw_bg.color: #x244a38 draw_bg.border_radius: 4.0 visible: false}
                wb5 := RoundedView{width: 24 height: 8 show_bg: true draw_bg.color: #x244a38 draw_bg.border_radius: 4.0 visible: false}
                wb6 := RoundedView{width: 24 height: 8 show_bg: true draw_bg.color: #x244a38 draw_bg.border_radius: 4.0 visible: false}
                wb7 := RoundedView{width: 24 height: 8 show_bg: true draw_bg.color: #x244a38 draw_bg.border_radius: 4.0 visible: false}
            }
            week_budget_note := Label{width: Fill text: "" draw_text.color: muted draw_text.text_style.font_size: 10}
        }
        rebalance_card := RoundedView{width: Fill height: Fit flow: Down spacing: 6 padding: Inset{left: 12 right: 12 top: 10 bottom: 10} show_bg: true draw_bg.color: #xfbf1e4 draw_bg.border_radius: 15.0 visible: false
            rebalance_title := Label{text: "省钱调整方案" draw_text.color: #x8a4b1e draw_text.text_style: theme.font_bold{font_size: 13}}
            rebalance_summary := Label{width: Fill text: "" draw_text.color: #x8a4b1e draw_text.text_style.font_size: 11}
            rebalance_items := ScrollYView{width: Fill height: 100 flow: Down spacing: 3 on_render: || {
                for change in rebalancePlan {
                    Label{width: Fill text: rebalance_line(change) draw_text.color: ink draw_text.text_style.font_size: 11}
                }
            }}
            View{width: Fill height: Fit flow: Right spacing: 8
                rebalance_apply := Accent{text: "应用并核验" on_click: || apply_rebalance()}
                rebalance_drop := Action{text: "忽略" on_click: || discard_rebalance()}
            }
        }
        draft_panel := RoundedView{width: Fill height: Fit flow: Down spacing: 8 padding: Inset{left: 12 right: 12 top: 10 bottom: 10} show_bg: true draw_bg.color: #xe9ede6 draw_bg.border_radius: 15.0 visible: false
            draft_summary := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style.font_size: 12}
            draft_items := ScrollYView{width: Fill height: 125 flow: Down spacing: 4 on_render: || {
                for choice in weekDraft {
                    let p = allProducts[choice.product_id]
                    Label{width: Fill text: choice.date + " · " + slot_label(choice.slot) + " · " + p.name + " · ¥" + cash(p.cents) draw_text.color: ink draw_text.text_style.font_size: 11}
                }
            }}
            week_agent_heading := Label{text: "让 Agent 调整这周" draw_text.color: blue draw_text.text_style: theme.font_bold{font_size: 14}}
            week_agent_intro := Label{width: Fill text: "先生成草案。Agent 只从已验证的换餐选项中提出改动，确认前不写入。" draw_text.color: muted draw_text.text_style.font_size: 11}
            ScrollYView{width: Fill height: 135 flow: Down
                week_agent_options := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style.font_size: 11}
            }
            week_agent_request := TextInput{width: Fill height: 40 text: "" empty_text: "少辣 / Less spicy…" on_change: |text| clear_week_agent_proposal()}
            View{width: Fill height: Fit flow: Right spacing: 8
                week_agent_ask := Action{text: "请 Agent 提案" on_click: || ask_week_agent()}
                week_agent_apply := Action{text: "应用建议到草案" on_click: || apply_week_agent()}
                week_agent_cancel := Action{text: "取消" visible: false on_click: || cancel_week_agent()}
            }
            week_agent_result := Label{width: Fill text: "写下想调整的口味或安排，再请 Agent 提案。" draw_text.color: ink draw_text.text_style.font_size: 11}
            View{width: Fill height: Fit flow: Right spacing: 8
                confirm_draft := Accent{text: "确认整周草案" on_click: || confirm_week_draft()}
                discard_draft := Action{text: "舍弃草案" on_click: || clear_week_draft()}
            }
        }
        checkin := RoundedView{width: Fill height: Fit flow: Down spacing: 8 padding: Inset{left: 14 right: 14 top: 12 bottom: 12} show_bg: true draw_bg.color: #xe9ede6 draw_bg.border_radius: 15.0 visible: false
            checkin_title := Label{text: "记录实际用餐" draw_text.color: blue draw_text.text_style: theme.font_bold{font_size: 14}}
            checkin_hint := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style.font_size: 12}
            actual_price_label := Label{text: "实际支付 · 元" draw_text.color: muted draw_text.text_style.font_size: 11}
            actual_price := Field{text: "" empty_text: "0.00"}
            View{width: Fill height: Fit flow: Right spacing: 8
                checkin_confirm := Accent{text: "确认已吃并保存" on_click: || confirm_checkin()}
                checkin_cancel := Action{text: "暂不记录" on_click: || {checkinSlot = -1 checkinDate = "" ui.checkin.set_visible(false)}}
            }
        }
        taste_card := RoundedView{width: Fill height: Fit flow: Down spacing: 8 padding: Inset{left: 14 right: 14 top: 12 bottom: 12} show_bg: true draw_bg.color: #xffffff draw_bg.border_radius: 15.0 visible: false
            taste_title := Label{text: "这顿怎么样？" draw_text.color: blue draw_text.text_style: theme.font_bold{font_size: 14}}
            taste_hint := Label{width: Fill text: "你的评价只留在本机，用来让下次推荐更合口味。" draw_text.color: muted draw_text.text_style.font_size: 11}
            View{width: Fill height: Fit flow: Right spacing: 8
                taste_like := Accent{text: "好吃" on_click: || { record_taste(tastePick, "like") close_taste() }}
                taste_mid := Action{text: "一般" on_click: || close_taste()}
                taste_dislike := Action{text: "不行" on_click: || { record_taste(tastePick, "dislike") close_taste() }}
            }
        }
        plans := ScrollYView{width: Fill height: Fit flow: Down spacing: 10 on_render: || {
            for offset in 7 {
                let date = week_date(currentDate, offset)
                let index = day_index(journal, date)
                let meals = []
                if index >= 0 { meals = journal.days[index].meals }
                // 按早餐/午餐/晚餐/加餐展示，与确认顺序无关。
                let ordered = []
                for slot in 4 {
                    for m in meals {
                        if m.slot == slot { ordered.push(m) }
                    }
                }
                RoundedView{width: Fill height: Fit flow: Down spacing: 8 padding: Inset{left: 14 right: 14 top: 12 bottom: 12} show_bg: true draw_bg.color: #xffffff draw_bg.border_radius: 15.0
                    Label{width: Fill text: date + L(" · 预算占用 ¥", " · Budget used ¥") + cash(sum_meals(meals, -1)) draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 14}}
                    if meals.len() == 0 {
                        if date == currentDate { Label{text: L("这一天还没有已确认计划。", "No confirmed meals for this day yet.") draw_text.color: muted draw_text.text_style.font_size: 12} }
                        else { Label{text: L("待安排", "To plan") draw_text.color: muted draw_text.text_style.font_size: 12} }
                        Action{text: L("安排这天", "Plan this day") on_click: || { ui.date.set_text(date) open_date() show_page(false) }}
                    }
                    for m in ordered {
                        View{width: Fill height: Fit flow: Down spacing: 5
                            View{width: Fill height: Fit flow: Right spacing: 8
                                View{width: Fill height: Fit flow: Down spacing: 5
                                    View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                                        Label{width: Fill text: slot_label(m.slot) + " · " + m.name + " · ¥" + cash(m.cents) + taste_badge(m.product_id) draw_text.color: ink draw_text.text_style.font_size: 13}
                                        if meal_eaten_at(m) != nil {
                                            RoundedView{width: Fit height: Fit padding: Inset{left: 8 right: 8 top: 2 bottom: 2} show_bg: true draw_bg.color: #x2e7d43 draw_bg.border_radius: 8.0
                                                Label{text: L("已吃", "Eaten") draw_text.color: #xffffff draw_text.text_style.font_size: 10}}
                                        }
                                        if meal_eaten_at(m) == nil {
                                            RoundedView{width: Fit height: Fit padding: Inset{left: 8 right: 8 top: 2 bottom: 2} show_bg: true draw_bg.color: #xe9ede6 draw_bg.border_radius: 8.0
                                                Label{text: L("待吃", "Planned") draw_text.color: ink draw_text.text_style.font_size: 10}}
                                        }
                                    }
                                    Label{width: Fill text: m.store + L(" · 到店 ", " · arrival ") + m.arrival draw_text.color: muted draw_text.text_style.font_size: 11}
                                    if meal_eaten_at(m) != nil { Label{width: Fill text: L("实际支付 ¥", "Paid ¥") + cash(meal_actual_cents(m)) draw_text.color: blue draw_text.text_style.font_size: 11} }
                                }
                                if allProducts[m.product_id].image_url != "" { Image{width: 60 height: 60 src: img_src_id(m.product_id) fit: ImageFit.CropToFill} }
                            }
                            if date == currentDate {
                                View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                                    if meal_eaten_at(m) == nil {
                                        if date == today() { Accent{width: Fill text: if english { "Mark eaten" } else { "记录已吃" + slot_label(m.slot) } on_click: || begin_checkin(m.slot)} }
                                        Action{text: L("修改", "Edit ") + slot_label(m.slot) on_click: || edit_meal(m.slot)}
                                        Action{text: L("取消", "Cancel ") + slot_label(m.slot) on_click: || cancel_meal(m.slot)}
                                    } else {
                                        Action{text: if english { "Undo eaten" } else { "撤销已吃" + slot_label(m.slot) } on_click: || undo_checkin(m.slot)}
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }}
    }
    status_card := RoundedView{width: Fill height: Fit flow: Down padding: Inset{left: 12 right: 12 top: 8 bottom: 8} show_bg: true draw_bg.color: #xe9ede6 draw_bg.border_radius: 12.0
        status := Label{width: Fill text: "正在启动…" draw_text.color: ink draw_text.text_style.font_size: 12}
    }
    footer_note := Label{width: Fill text: "金额是计划开销，未下单 · 菜单非实时" draw_text.color: muted draw_text.text_style.font_size: 10}
}
