    ui.results.set_visible(false)
}
fn refresh_language(){
    ui.lang_toggle.set_text(L("EN", "中文"))
    ui.home_nav.set_text(L("下一顿", "Next meal"))
    ui.week_nav.set_text(L("餐表", "Week"))
    ui.setup_title.set_text(L("先把饭钱留出来。", "Set aside meal money."))
    ui.setup_intro.set_text(L("告诉我可支配生活费和必须先付的开销，再决定每天能用多少吃饭。", "Start with your monthly allowance and essential non-food costs."))
    ui.setup_menu_title.set_text(L("01 · 选择食堂菜单", "01 · Choose a canteen menu"))
    if menuKind == "custom-v1" {
        ui.setup_menu_info.set_text(L("已导入：", "Imported: ") + menuSource + " · " + menuUpdated + " · " + allProducts.len() + L(" 道餐品", " items"))
    } else {
        ui.setup_menu_info.set_text(L("当前可用：广州软件学院食堂菜单快照 · 1,497 条商品。价格和营业时段可能已变化。", "Available now: a 1,497-item snapshot from Guangzhou Software Institute. Prices and hours may have changed."))
    }
    ui.setup_menu_limit.set_text(L("也可粘贴自己的 JSON 菜单；当前宿主没有文件选择器，自动采集尚未接入。", "You can paste a JSON menu; this host has no file picker. Automatic collection is not available."))
    ui.setup_import_toggle.set_text(L("导入自己的菜单 →", "Import your menu →"))
    ui.setup_import_title.set_text(L("导入自己的食堂菜单（可选）", "Import your canteen menu (optional)"))
    ui.setup_import_source_label.set_text(L("数据来源名称", "Source name"))
