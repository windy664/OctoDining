    date_bar := RoundedView{width: Fill height: Fit flow: Right spacing: 8 padding: Inset{left: 10 right: 10 top: 8 bottom: 8} show_bg: true draw_bg.color: #xffffff draw_bg.border_radius: 14.0
        date := Field{text: "" empty_text: "YYYY-MM-DD" on_change: |text| invalidate()}
        open_day := Action{text: "打开日期" on_click: || open_date()}
    }
    tabs := View{width: Fill height: Fit flow: Right spacing: 8
        tab_choose := Action{width: Fill text: "调整这餐" on_click: || show_page(false)}
        tab_history := Action{width: Fill text: "一周餐表" on_click: || show_page(true)}
    }
    selection := ScrollYView{width: Fill height: Fill flow: Down spacing: 10
        conditions_title := Label{text: "用餐条件" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}}
        RoundedView{width: Fill height: Fit flow: Down spacing: 10 padding: Inset{left: 14 right: 14 top: 14 bottom: 14} show_bg: true draw_bg.color: #xffffff draw_bg.border_radius: 16.0
            tier_heading := Label{text: "预算档位" draw_text.color: muted draw_text.text_style.font_size: 12}
            View{width: Fill height: Fit flow: Right spacing: 4
                a1 := Action{width: Fill text: "A1" on_click: || apply_tier(0)}
                a2 := Action{width: Fill text: "A2" on_click: || apply_tier(1)}
                a3 := Action{width: Fill text: "A3" on_click: || apply_tier(2)}
                a4 := Action{width: Fill text: "A4" on_click: || apply_tier(3)}
                a5 := Action{width: Fill text: "A5" on_click: || apply_tier(4)}
                a6 := Action{width: Fill text: "A6" on_click: || apply_tier(5)}
            }
            tier_label := Label{text: "A3" draw_text.color: muted draw_text.text_style.font_size: 12}
            View{width: Fill height: Fit flow: Right spacing: 6
                breakfast := Action{width: Fill text: "早餐" on_click: || apply_slot(0)}
                lunch := Action{width: Fill text: "午餐" on_click: || apply_slot(1)}
                dinner := Action{width: Fill text: "晚餐" on_click: || apply_slot(2)}
            }
            slot_label := Label{text: "晚餐" draw_text.color: muted draw_text.text_style.font_size: 12}
        }
        RoundedView{width: Fill height: Fit flow: Down spacing: 10 padding: Inset{left: 14 right: 14 top: 14 bottom: 14} show_bg: true draw_bg.color: #xffffff draw_bg.border_radius: 16.0
            View{width: Fill height: Fit flow: Right spacing: 8
                View{width: Fill height: Fit flow: Down spacing: 3
                    daily_heading := Label{text: "日预算（元）" draw_text.color: muted draw_text.text_style.font_size: 12}
                    daily := Field{text: "32.00" on_change: |text| invalidate()}
                }
                View{width: Fill height: Fit flow: Down spacing: 3
                    budget_heading := Label{text: "本餐上限（元）" draw_text.color: muted draw_text.text_style.font_size: 12}
                    budget := Field{text: "14.00" on_change: |text| invalidate()}
                }
                View{width: Fill height: Fit flow: Down spacing: 3
                    arrival_heading := Label{text: "到店时间" draw_text.color: muted draw_text.text_style.font_size: 12}
                    arrival := Field{text: "18:30" on_change: |text| invalidate()}
                }
            }
            avoid_spicy := CheckBox{text: "关键词避辣（不保证过敏原或辣度）" on_click: |active| invalidate()}
            View{width: Fill height: Fit flow: Right spacing: 8
                find := Action{width: Fill text: "只看候选" on_click: || find_candidates()}
                save_daily := Action{text: "保存日预算" on_click: || save_budget()}
            }
        }
        budget_explain := Label{width: Fill text: "单餐上限与每日总预算同时生效。已有餐次会计入剩余金额。" draw_text.color: muted draw_text.text_style.font_size: 12}
    }
    results := ScrollYView{width: Fill height: Fill flow: Down spacing: 10
        View{width: Fill height: Fit flow: Right spacing: 8
            adjust_conditions := Action{text: "调整条件" on_click: || show_page(false)}
            next_batch := Action{text: "换一批候选" on_click: || find_candidates()}
        }
        RoundedView{width: Fill height: Fit flow: Down spacing: 8 padding: Inset{left: 14 right: 14 top: 13 bottom: 13} show_bg: true draw_bg.color: #xe9ede6 draw_bg.border_radius: 16.0
            agent_heading := Label{text: "Agent 的建议" draw_text.color: blue draw_text.text_style: theme.font_bold{font_size: 14}}
            agent_result := Label{width: Fill text: "先生成候选，再请系统 Agent 比较。" draw_text.color: ink draw_text.text_style.font_size: 12}
            ask_agent := Action{text: "重新请 Agent 比较" on_click: || ask_agent()}
        }
        choices := View{width: Fill height: Fit flow: Down spacing: 10 on_render: || {
            if candidates.len() == 0 { Label{width: Fill text: L("填写条件后查找候选。价格和时段来自菜单快照。", "Set your preferences to find options. Prices and hours are from a menu snapshot.") draw_text.color: muted draw_text.text_style.font_size: 13} }
            for i in candidates.len() {
                let p = allProducts[candidates[i]]
                RoundedView{width: Fill height: Fit flow: Down spacing: 7 padding: Inset{left: 14 right: 14 top: 12 bottom: 12} show_bg: true draw_bg.color: #xffffff draw_bg.border_radius: 15.0
                    View{width: Fill height: Fit flow: Right spacing: 9
                        View{width: Fill height: Fit flow: Down spacing: 5
                            Label{width: Fill text: p.name + " · ¥" + cash(p.cents) draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                            Label{width: Fill text: p.store + " · " + p.business_hours draw_text.color: muted draw_text.text_style.font_size: 12}
                        }
                        if p.image_url != "" { Image{width: 72 height: 72 src: http_resource(p.image_url) fit: ImageFit.CropToFill} }
                    }
                    if agentChoice == i && agentStamp == candidateStamp { Label{width: Fill text: L("OctoSense Agent 建议", "OctoSense Agent pick") draw_text.color: blue draw_text.text_style.font_size: 12} }
                    Accent{text: L("确认候选 ", "Confirm option ") + (i + 1) on_click: || choose_meal(i)}
                }
            }
        }}
    }
    history := ScrollYView{width: Fill height: Fill flow: Down spacing: 10
        week_title := Label{width: Fill text: "我的一周餐表 · 从所选日期起七天" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}}
        View{width: Fill height: Fit flow: Right spacing: 8
            make_draft := Action{text: "生成七天草案" on_click: || generate_week_draft()}
        }
        draft_panel := RoundedView{width: Fill height: Fit flow: Down spacing: 8 padding: Inset{left: 12 right: 12 top: 10 bottom: 10} show_bg: true draw_bg.color: #xe9ede6 draw_bg.border_radius: 15.0 visible: false
            draft_summary := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style.font_size: 12}
            draft_items := ScrollYView{width: Fill height: 125 flow: Down spacing: 4 on_render: || {
                for choice in weekDraft {
                    let p = allProducts[choice.product_id]
                    Label{width: Fill text: choice.date + " · " + slot_label(choice.slot) + " · " + p.name + " · ¥" + cash(p.cents) draw_text.color: ink draw_text.text_style.font_size: 11}
                }
            }}
            week_agent_heading := Label{text: "让 Agent 调整这周" draw_text.color: blue draw_text.text_style: theme.font_bold{font_size: 14}}
            week_agent_intro := Label{width: Fill text: "先生成草案。Agent 只从已验证的换餐选项中提出改动，确认前不写入。" draw_text.color: muted draw_text.text_style.font_size: 11}
            ScrollYView{width: Fill height: 135 flow: Down
                week_agent_options := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style.font_size: 11}
            }
            week_agent_request := TextInput{width: Fill height: 40 text: "" empty_text: "少辣 / Less spicy…" on_change: |text| clear_week_agent_proposal()}
            View{width: Fill height: Fit flow: Right spacing: 8
                week_agent_ask := Action{text: "请 Agent 提案" on_click: || ask_week_agent()}
                week_agent_apply := Action{text: "应用建议到草案" on_click: || apply_week_agent()}
            }
            week_agent_result := Label{width: Fill text: "写下想调整的口味或安排，再请 Agent 提案。" draw_text.color: ink draw_text.text_style.font_size: 11}
            View{width: Fill height: Fit flow: Right spacing: 8
                confirm_draft := Accent{text: "确认整周草案" on_click: || confirm_week_draft()}
                discard_draft := Action{text: "舍弃草案" on_click: || clear_week_draft()}
            }
        }
        checkin := RoundedView{width: Fill height: Fit flow: Down spacing: 8 padding: Inset{left: 14 right: 14 top: 12 bottom: 12} show_bg: true draw_bg.color: #xe9ede6 draw_bg.border_radius: 15.0 visible: false
            checkin_title := Label{text: "记录实际用餐" draw_text.color: blue draw_text.text_style: theme.font_bold{font_size: 14}}
            checkin_hint := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style.font_size: 12}
            actual_price_label := Label{text: "实际支付 · 元" draw_text.color: muted draw_text.text_style.font_size: 11}
            actual_price := Field{text: "" empty_text: "0.00"}
            View{width: Fill height: Fit flow: Right spacing: 8
                checkin_confirm := Accent{text: "确认已吃并保存" on_click: || confirm_checkin()}
                checkin_cancel := Action{text: "暂不记录" on_click: || {checkinSlot = -1 checkinDate = "" ui.checkin.set_visible(false)}}
            }
        }
        plans := View{width: Fill height: Fit flow: Down spacing: 10 on_render: || {
            for offset in 7 {
                let date = week_date(currentDate, offset)
                let index = day_index(journal, date)
                let meals = []
                if index >= 0 { meals = journal.days[index].meals }
                RoundedView{width: Fill height: Fit flow: Down spacing: 8 padding: Inset{left: 14 right: 14 top: 12 bottom: 12} show_bg: true draw_bg.color: #xffffff draw_bg.border_radius: 15.0
                    Label{width: Fill text: date + L(" · 预算占用 ¥", " · Budget used ¥") + cash(sum_meals(meals, -1)) draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 14}}
                    if meals.len() == 0 {
                        if date == currentDate { Label{text: L("这一天还没有已确认计划。", "No confirmed meals for this day yet.") draw_text.color: muted draw_text.text_style.font_size: 12} }
                        else { Label{text: L("待安排", "To plan") draw_text.color: muted draw_text.text_style.font_size: 12} }
                        Action{text: L("安排这天", "Plan this day") on_click: || { ui.date.set_text(date) open_date() show_page(false) }}
                    }
                    for m in meals {
                        View{width: Fill height: Fit flow: Down spacing: 5
                            View{width: Fill height: Fit flow: Right spacing: 8
                                View{width: Fill height: Fit flow: Down spacing: 5
                                    Label{width: Fill text: slot_label(m.slot) + " · " + m.name + " · ¥" + cash(m.cents) + (if meal_eaten_at(m) != nil { L(" · 已吃", " · eaten") } else { L(" · 待吃", " · planned") }) draw_text.color: ink draw_text.text_style.font_size: 13}
                                    Label{width: Fill text: m.store + L(" · 到店 ", " · arrival ") + m.arrival draw_text.color: muted draw_text.text_style.font_size: 11}
                                    if meal_eaten_at(m) != nil { Label{width: Fill text: L("实际支付 ¥", "Paid ¥") + cash(meal_actual_cents(m)) draw_text.color: blue draw_text.text_style.font_size: 11} }
                                }
                                if allProducts[m.product_id].image_url != "" { Image{width: 60 height: 60 src: http_resource(allProducts[m.product_id].image_url) fit: ImageFit.CropToFill} }
                            }
                            if date == currentDate {
                                View{width: Fill height: Fit flow: Right spacing: 8
                                    if meal_eaten_at(m) == nil {
                                        Action{text: L("修改", "Edit ") + slot_label(m.slot) on_click: || edit_meal(m.slot)}
                                        Action{text: L("取消", "Cancel ") + slot_label(m.slot) on_click: || cancel_meal(m.slot)}
                                        if date == today() { Action{text: if english { "Mark eaten" } else { "记录已吃" + slot_label(m.slot) } on_click: || begin_checkin(m.slot)} }
                                    } else {
                                        Action{text: if english { "Undo eaten" } else { "撤销已吃" + slot_label(m.slot) } on_click: || undo_checkin(m.slot)}
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }}
    }
    status_card := RoundedView{width: Fill height: Fit flow: Down padding: Inset{left: 12 right: 12 top: 8 bottom: 8} show_bg: true draw_bg.color: #xe9ede6 draw_bg.border_radius: 12.0
        status := Label{width: Fill text: "正在启动…" draw_text.color: ink draw_text.text_style.font_size: 12}
    }
    footer_note := Label{width: Fill text: "金额是计划开销，未下单 · 菜单非实时" draw_text.color: muted draw_text.text_style.font_size: 10}
}
