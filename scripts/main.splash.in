let defaultTimes = ["08:00" "12:00" "18:30"]
let selectedTier = 2
let selectedSlot = 2
let currentDate = ""
let journal = {schema: 1 revision: 0 last_date: "" days: []}
let activeFile = ""
let storageReady = true
let candidates = []
let candidateStamp = ""
let searchCursor = 0
let lastSearch = ""
let agentRequest = 0
let agentBusy = false
let agentChoice = -1
let agentStamp = ""
let homePick = -1
let homeSkip = -1
let homeShowingSaved = false
