fn show_page(history){
    onHome = false
    ui.setup.set_visible(false)
    ui.week_nav.set_visible(false)
    ui.home_nav.set_visible(true)
    ui.intro.set_visible(false)
    ui.summary_card.set_visible(true)
    ui.status_card.set_visible(true)
    ui.footer_note.set_visible(true)
    ui.home.set_visible(false)
    ui.home_actions.set_visible(false)
    ui.hero.set_visible(!history)
    ui.hero_title.set_visible(false)
    ui.hero_subtitle.set_visible(false)
    ui.hero_note.set_visible(false)
    ui.date_bar.set_visible(true)
    ui.tabs.set_visible(true)
    ui.selection.set_visible(!history)
    ui.history.set_visible(history)
    ui.results.set_visible(false)
    if history { ui.plans.render() }
}
fn clear_week_draft(){
    weekAgentRequest += 1
    weekAgentBusy = false
    weekAgentOffers = []
    weekAgentChanges = []
    weekAgentStamp = ""
    weekDraft = []
    weekDraftRevision = -1
    weekDraftStart = ""
    weekDraftProfileDaily = -1
    ui.draft_panel.set_visible(false)
}
fn week_draft_stamp(){
    let stamp = "" + journal.revision + "|" + currentDate + "|" + profileDaily + "|" + menuKind + "|" + ui.week_agent_request.text().trim()
    for choice in weekDraft { stamp += "|" + choice.date + ":" + choice.slot + ":" + choice.product_id }
    stamp
}
fn clear_week_agent_proposal(){
    weekAgentRequest += 1
    weekAgentBusy = false
    weekAgentChanges = []
    weekAgentStamp = ""
    ui.week_agent_result.set_text(L("写下想调整的口味或安排，再请 Agent 提案。", "Describe a preference, then ask the Agent for changes."))
}
fn go_next_meal(){
    let target = next_meal_target()
    selectedSlot = target.slot
    ui.date.set_text(target.date)
    ui.arrival.set_text(defaultTimes[target.slot])
    homeSkip = -1
    homeSeen = []
    open_date()
    show_home()
}
