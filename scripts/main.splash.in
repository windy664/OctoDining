        ui.setup_result.set_text(L("先扣除非餐饮开销与缓冲金，再按 30 天估算饭钱。", "Subtract non-food costs and reserve, then estimate meals over 30 days."))
    } else { setup_calculation() }
}
fn switch_language(){
    english = !english
    agentRequest += 1
    agentBusy = false
    agentChoice = -1
    agentStamp = ""
    try { fs.write("language.json", {lang: L("zh", "en")}.to_json()) } { }
    refresh_language()
    refresh_summary()
    ui.plans.render()
    ui.choices.render()
    ui.agent_result.set_text(L("语言已切换；如需 Agent 建议，请重新比较候选。", "Language changed. Ask the Agent again for an explanation."))
    ui.status.set_text(L("语言已切换。", "Language changed."))
}
fn profile_limit(slot){
    if profileReady && money_value(ui.daily.text()) == profileDaily {
        if slot == 0 { return floor(profileDaily * 0.30) }
        return floor(profileDaily * 0.40)
    }
    limits[selectedTier][slot]
}
fn setup_calculation(){
    let monthly = monthly_value(ui.setup_monthly.text())
    let fixed = monthly_value(ui.setup_fixed.text())
    let reserve = monthly_value(ui.setup_reserve.text())
    if monthly < 10000 || fixed < 0 || reserve < 0 || fixed + reserve >= monthly {
        ui.setup_result.set_text(L("请填写每月生活费，以及非餐饮固定开销和缓冲金；扣除后须有餐饮预算。", "Enter your monthly allowance, non-food essentials and reserve; some meal budget must remain."))
        return -1
    }
    let daily = floor((monthly - fixed - reserve) / 30)
    if daily < 100 || daily > 50000 {
        ui.setup_result.set_text(L("按 30 天估算的每日餐饮预算须在 ¥1–500 之间，请调整数字。", "The estimated daily meal budget must be ¥1–500. Adjust the amounts."))
        return -1
    }
    let note = L("按 30 天估算：每月可用于吃饭 ¥", "Over 30 days: monthly meals ¥") + cash(monthly - fixed - reserve)
        + L("，每天约 ¥", ", about ¥") + cash(daily) + L("；弹性上限：早餐 ¥", "/day. Flexible caps: breakfast ¥")
        + cash(floor(daily * 0.30)) + L("，午餐与晚餐各 ¥", ", lunch and dinner ¥") + cash(floor(daily * 0.40))
        + L("，三餐合计仍不得超过日预算。", " each; the daily total still applies.")
    if daily < 3000 { note += L(" 预算偏紧，不能仅靠本菜单证明三餐足量；请调整分配或人工检查。", " This is tight. The menu cannot prove three adequate meals; review the split.") }
    else { note += L(" 这只是分配起点；份量和营养仍须人工核对。", " This is a starting split; check portions and nutrition yourself.") }
    ui.setup_result.set_text(note)
    daily
}
fn finish_setup(){
    let daily = setup_calculation()
    if daily < 0 { return }
    let record = {schema: 1 menu: menuKind monthly_cents: monthly_value(ui.setup_monthly.text()) fixed_cents: monthly_value(ui.setup_fixed.text()) reserve_cents: monthly_value(ui.setup_reserve.text()) daily_cents: daily}
    let saved = false
    try {
        fs.write("profile.json", record.to_json())
        let readback = fs.read("profile.json").parse_json()
        if readback.schema == 1 && readback.menu == menuKind && readback.daily_cents == daily { saved = true }
    } { saved = false }
    if !saved { ui.setup_result.set_text(L("设置未能保存并读回；请检查存储后重试。", "Could not save and read back settings. Check storage and retry.")) return }
    profileDaily = daily
    profileReady = true
    clear_week_draft()
    ui.date.set_text(today())
    ui.daily.set_text(cash(daily))
    ui.budget.set_text(cash(profile_limit(selectedSlot)))
    go_next_meal()
}
fn plan_with_agent(){
    find_candidates()
    if candidates.len() > 0 { ask_agent() }
}
fn refresh_summary(){
    let total = sum_meals(current_meals(), -1)
    let daily = money_value(ui.daily.text())
    let spent = 0
    let pending = 0
    for meal in current_meals() {
        if meal_eaten_at(meal) != nil { spent += meal_actual_cents(meal) }
        else { pending += meal.cents }
    }
    let summary = currentDate + L(" · 已计划 ¥", " · Planned ¥") + cash(pending)
    if spent > 0 { summary += L(" · 已吃 ¥", " · Eaten ¥") + cash(spent) }
    if daily >= 0 {
        if total <= daily { summary += L(" · 剩余 ¥", " · Left ¥") + cash(daily - total) }
        else { summary += L(" · 超支 ¥", " · Over budget ¥") + cash(total - daily) }
    }
    ui.summary.set_text(summary)
    ui.tier_label.set_text(L("当前 A", "Tier A") + (selectedTier + 1) + L(" · 原档日预算 ¥", " · default daily ¥") + cash(tiers[selectedTier]) + L("（可改）", " (editable)"))
    ui.slot_label.set_text(L("正在安排：", "Planning: ") + slot_label(selectedSlot) + L(" · 确认会替换同日同餐次", " · confirming replaces this meal on this date"))
    ui.home_caption.set_text(home_day_label() + " · " + slot_label(selectedSlot))
    refresh_home()
}
fn set_home_image(productId){
    if productId >= 0 && allProducts[productId].image_url != "" {
        ui.dish_image.set_src(http_resource(allProducts[productId].image_url))
        ui.home_image_wrap.set_visible(true)
        ui.image_note.set_text(L("菜单配图 · 仅供参考", "Menu image"))
    } else {
        ui.home_image_wrap.set_visible(false)
    }
}
fn refresh_home(){
    homePick = -1
    homeShowingSaved = false
    set_home_image(-1)
    if ui.date.text().trim() != currentDate || !valid_date(currentDate) {
        ui.home_name.set_text(L("先打开一个有效日期", "Open a valid date first"))
        ui.home_cta.set_text(L("调整条件", "Edit settings"))
        ui.home_price.set_text("")
        ui.home_meta.set_text(L("日期变化后会重新计算推荐", "Suggestions update when the date changes"))
        ui.home_reason.set_text("")
        return
    }
    for meal in current_meals() {
        if meal.slot == selectedSlot && homeSkip < 0 {
            homePick = meal.product_id
            homeShowingSaved = true
            let eaten_at = meal_eaten_at(meal)
            ui.home_caption.set_text(home_day_label() + " · " + slot_label(selectedSlot))
            ui.home_name.set_text(meal.name)
            set_home_image(meal.product_id)
            ui.home_price.set_text("¥" + cash(meal.cents))
            ui.home_meta.set_text(meal.store + " · " + meal.arrival + L(" 到店", " arrival"))
            if eaten_at != nil { ui.home_reason.set_text(L("这餐已记录为吃过，实际支付 ¥", "Recorded as eaten; amount paid ¥") + cash(meal_actual_cents(meal)) + L("。", ".")) }
            else { ui.home_reason.set_text(L("已经写入餐表。想换口味，可以点“换一道”。", "Saved to your plan. Try another dish if you want a change.")) }
            ui.home_cta.set_text(L("查看今日餐表", "View today's plan"))
            return
        }
    }
    ui.home_caption.set_text(home_day_label() + " · " + slot_label(selectedSlot))
    ui.home_cta.set_text(L("就吃这道 · 加入餐表", "Add this to my plan"))
    let daily = money_value(ui.daily.text())
    let budget = money_value(ui.budget.text())
    let arrival = clock_value(ui.arrival.text().trim())
    let request = ui.request.text().trim()
    if daily < 0 || budget < 0 || arrival < 0 || request.len() > 500 || regex("过敏|素食|清淡|高蛋白|不吃肉|不吃牛肉|不吃猪肉|不吃奶|不吃蛋|花生|海鲜|allerg|Allerg|vegetarian|Vegetarian|vegan|Vegan|gluten|Gluten|peanut|Peanut|seafood|Seafood|dairy|Dairy|high.protein", "").test(request) {
        ui.home_name.set_text(L("暂不能可靠推荐", "Cannot suggest safely"))
        ui.home_cta.set_text(L("调整条件", "Edit settings"))
        ui.home_price.set_text("")
        ui.home_meta.set_text(L("请核对预算、时间和饮食限制", "Check budget, time and dietary needs"))
        ui.home_reason.set_text(L("菜单不含完整营养或过敏原信息。", "The menu lacks nutrition and allergen details."))
        return
    }
    let cap = min(budget, daily - sum_meals(current_meals(), selectedSlot))
    if cap < 100 {
        ui.home_name.set_text(L("本餐预算不足", "Meal budget too low"))
        ui.home_cta.set_text(L("调整条件", "Edit settings"))
        ui.home_price.set_text("")
        ui.home_meta.set_text(L("先调整预算或已有计划", "Adjust the budget or existing plans"))
        ui.home_reason.set_text("")
        return
    }
    let avoid = ui.avoid_spicy.checked() || regex("不吃辣|不要辣|少辣|避辣|别太辣|not spicy|Not spicy|less spicy|Less spicy|no chili|No chili|mild|Mild", "").test(request)
    let recentIds = []
    let recentStores = []
    let first = max(0, journal.days.len() - 7)
    for dayIndex in first..journal.days.len() {
        for meal in journal.days[dayIndex].meals {
            recentIds.push(meal.product_id)
            recentStores.push(meal.store)
        }
    }
    let bestScore = 999999
    // Bound home scoring well below the script handler's instruction limit.
    // A coprime stride samples throughout the menu rather than its first shops.
    for sample in min(220, allProducts.len()) {
        let i = (sample * 7) % allProducts.len()
        let p = allProducts[i]
        let seen = i == homeSkip
        for previous in homeSeen { if previous == i { seen = true } }
        if !seen && p.cents <= cap && matches_meal(p) && open_at(p.business_hours, arrival) {
            let spicy = regex("辣|麻|椒", "").test(p.name + " " + p.category)
            if !avoid || !spicy {
                let score = abs(p.cents - round(cap * 0.75))
                if regex("饭", "").test(p.name) { score -= 950 }
                else if regex("面|粉|米线|饺子|馄饨|云吞", "").test(p.name) { score -= 300 }
                score += p.name.len() * 18
                if regex("\\+|[0-9]素|[0-9]荤|特价|【|】", "").test(p.name) { score += 1500 }
                for id in recentIds { if id == i { score += 900 } }
                for store in recentStores { if store == p.store { score += 80 } }
                if score < bestScore { bestScore = score homePick = i }
            }
        }
    }
    if homePick < 0 {
        ui.home_name.set_text(L("暂无符合条件的餐品", "No matching meal"))
        ui.home_cta.set_text(L("调整条件", "Edit settings"))
        ui.home_price.set_text("")
        ui.home_meta.set_text(L("请调整预算、到店时间或口味", "Change budget, arrival time or taste"))
        ui.home_reason.set_text(L("推荐只使用当前已核验的菜单记录。", "Suggestions use only the current verified menu records."))
        return
    }
    let pick = allProducts[homePick]
    ui.home_name.set_text(pick.name)
    set_home_image(homePick)
    ui.home_price.set_text("¥" + cash(pick.cents))
    ui.home_meta.set_text(pick.store + " · " + ui.arrival.text().trim() + L(" 可到店", " arrival"))
    if recentIds.len() == 0 {
        ui.home_reason.set_text(L("根据菜单价格、餐次和到店时段推荐；暂无已存历史计划。", "Based on menu price, meal type and hours; no saved history yet."))
    } else {
        ui.home_reason.set_text(L("预算内、到店时段匹配；参考近七条已存日期的选择，尽量减少重复。", "Within budget and open at arrival; recent saved choices help reduce repeats."))
    }
}
fn next_home_pick(){
    if homePick >= 0 { homeSeen.push(homePick) }
    homeSkip = homePick
    refresh_home()
    if homePick < 0 && homeSeen.len() > 0 {
        homeSeen = []
        homeSkip = -1
        refresh_home()
    }
}
fn confirm_home_pick(){
    if homeShowingSaved { show_page(true) return }
    if homePick < 0 || !storageReady { show_page(false) return }
    let id = homePick
    let before = journal.revision
    hide_candidates()
    candidates = [id]
    candidateStamp = selection_stamp()
    choose_meal(0)
    if journal.revision == before { show_page(false) }
}
fn apply_slot(slot){
    selectedSlot = slot
    ui.budget.set_text(cash(profile_limit(slot)))
    ui.arrival.set_text(defaultTimes[slot])
    invalidate()
}
fn apply_tier(tier){
    selectedTier = tier
    ui.daily.set_text(cash(tiers[tier]))
    ui.budget.set_text(cash(limits[tier][selectedSlot]))
    invalidate()
}
fn open_date(){
    let date = ui.date.text().trim()
    if !valid_date(date) { ui.status.set_text(L("请填写有效日期，例如 2026-10-03。", "Enter a valid date, for example 2026-10-03.")) return }
    currentDate = date
    clear_week_draft()
    checkinSlot = -1
    checkinDate = ""
    ui.checkin.set_visible(false)
    let i = day_index(journal, date)
    if i >= 0 {
        selectedTier = journal.days[i].tier
        ui.daily.set_text(cash(journal.days[i].daily_cents))
    } else {
        if profileReady { ui.daily.set_text(cash(profileDaily)) }
        else { ui.daily.set_text(cash(tiers[selectedTier])) }
    }
    ui.budget.set_text(cash(profile_limit(selectedSlot)))
    hide_candidates()
    refresh_summary()
    ui.plans.render()
    ui.status.set_text(L("已打开 ", "Opened meal plan for ") + date + L(" 的餐饮计划。", "."))
}
fn read_conditions(){
    if ui.date.text().trim() != currentDate || !valid_date(currentDate) {
        ui.status.set_text(L("日期已改动，请先点「打开日期」。", "Date changed. Open the date before continuing.")) return nil
    }
    for meal in current_meals() {
        if meal.slot == selectedSlot && meal_eaten_at(meal) != nil {
            ui.status.set_text(L("这餐已记录为吃过；若记错了，请先在餐表撤销用餐记录。", "This meal is marked eaten. Undo that record in the week plan before changing it."))
            return nil
        }
    }
    let daily = money_value(ui.daily.text())
    let budget = money_value(ui.budget.text())
    let arrival = clock_value(ui.arrival.text().trim())
    if daily < 0 || budget < 0 || arrival < 0 {
        ui.status.set_text(L("预算需为 1–500 元、最多两位小数；时间需为有效 HH:MM。", "Budget must be ¥1–500 with at most two decimals; time must be HH:MM.")) return nil
    }
    let request = ui.request.text().trim()
    if request.len() > 500 { ui.status.set_text(L("需求请控制在 500 字以内。", "Keep the request under 500 characters.")) return nil }
    if regex("过敏|素食|清淡|高蛋白|不吃肉|不吃牛肉|不吃猪肉|不吃奶|不吃蛋|花生|海鲜|allerg|Allerg|vegetarian|Vegetarian|vegan|Vegan|gluten|Gluten|peanut|Peanut|seafood|Seafood|dairy|Dairy|high.protein", "").test(request) {
        ui.status.set_text(L("菜单无法可靠核验这类饮食限制。当前支持预算、到店时间和关键词避辣。", "The menu cannot verify these dietary restrictions. Budget, arrival time and spicy-keyword avoidance are supported.")) return nil
    }
    let other = sum_meals(current_meals(), selectedSlot)
    if other >= daily {
        ui.status.set_text(L("其他餐次已用完当前日预算，请增加预算或取消已有计划。", "Other meals use the daily budget. Increase it or change an existing plan.")) return nil
    }
    let avoid = ui.avoid_spicy.checked() || regex("不吃辣|不要辣|少辣|避辣|别太辣|not spicy|Not spicy|less spicy|Less spicy|no chili|No chili|mild|Mild", "").test(request)
    {daily: daily cap: min(budget, daily - other) arrival: arrival avoid: avoid request: request}
}
fn find_candidates(){
    hide_candidates()
    let condition = read_conditions()
    if condition == nil { return }
    let stamp = selection_stamp()
    if stamp != lastSearch { searchCursor = 0 }
    lastSearch = stamp
    let stores = []
    if homePick >= 0 {
        let first = allProducts[homePick]
        let spicy = regex("辣|麻|椒", "").test(first.name + " " + first.category)
        if first.cents <= condition.cap && matches_meal(first) && open_at(first.business_hours, condition.arrival) && (!condition.avoid || !spicy) {
            candidates.push(homePick)
            stores.push(first.store)
        }
    }
    let examined = 0
    while examined < allProducts.len() && candidates.len() < 3 {
        let idx = searchCursor % allProducts.len()
        searchCursor += 1
        examined += 1
        let p = allProducts[idx]
        if p.cents <= condition.cap && matches_meal(p) && open_at(p.business_hours, condition.arrival) {
            let duplicate = false
            for store in stores { if store == p.store { duplicate = true } }
            let spicy = regex("辣|麻|椒", "").test(p.name + " " + p.category)
            if !duplicate && (!condition.avoid || !spicy) {
                candidates.push(idx)
                stores.push(p.store)
            }
        }
    }
    candidateStamp = stamp
    ui.choices.render()
    if candidates.len() == 0 {
        ui.status.set_text(L("没有符合预算、时段和口味的候选，请调整条件。", "No option fits budget, hours and taste. Edit the settings."))
    } else {
        onHome = false
        ui.home_nav.set_visible(true)
        ui.intro.set_visible(false)
        ui.summary_card.set_visible(true)
        ui.status_card.set_visible(true)
        ui.footer_note.set_visible(true)
        ui.home.set_visible(false)
        ui.home_actions.set_visible(false)
        ui.hero.set_visible(false)
        ui.date_bar.set_visible(false)
        ui.tabs.set_visible(true)
        ui.selection.set_visible(false)
        ui.history.set_visible(false)
        ui.results.set_visible(true)
        ui.status.set_text(L("找到 ", "Found ") + candidates.len() + L(" 个候选 · 本餐可用 ¥", " options · meal budget ¥") + cash(condition.cap) + L("。再次查找可换一批。", ". Search again for more."))
    }
}
fn prepare_day(daily){
    let next = journal.to_json().parse_json()
    let idx = day_index(next, currentDate)
    if idx < 0 {
        if next.days.len() >= 90 { ui.status.set_text(L("已保存 90 个日期，请先导出整理历史记录。", "90 dates are saved. Organize earlier records before adding more.")) return nil }
        next.days.push({date: currentDate daily_cents: daily tier: selectedTier meals: []})
        idx = next.days.len() - 1
    }
    next.last_date = currentDate
    next.days[idx].daily_cents = daily
    next.days[idx].tier = selectedTier
    next
}
fn choose_meal(index){
    if candidateStamp == "" || candidateStamp != selection_stamp() {
        invalidate()
        return
    }
    if index < 0 || index >= candidates.len() { return }
    let condition = read_conditions()
    if condition == nil { return }
    let product_id = candidates[index]
    let p = allProducts[product_id]
    if p.cents > condition.cap { invalidate() return }
    let next = prepare_day(condition.daily)
    if next == nil { return }
    let d = day_index(next, currentDate)
    let kept = []
    for m in next.days[d].meals {
        if m.slot == selectedSlot && meal_eaten_at(m) != nil {
            ui.status.set_text(L("这餐已记录为吃过；如需更正，请先在餐表撤销记录。", "This meal was recorded as eaten. Undo that record in the week plan before replacing it."))
            return
        }
        if m.slot != selectedSlot { kept.push(m) }
    }
    kept.push({slot: selectedSlot product_id: product_id cents: p.cents name: p.name store: p.store hours: p.business_hours arrival: ui.arrival.text().trim() note: condition.request saved_at: time_now()})
    next.days[d].meals = kept
    if store_record(next) {
        hide_candidates()
        homeSkip = -1
        refresh_summary()
        show_page(true)
        ui.status.set_text(L("已保存并读回核验：", "Saved and read back: ") + slot_label(selectedSlot) + " · " + p.name + L("。仅为计划，未下单。", ". Planned only; no order placed."))
    }
}
fn week_meal_limit(daily, slot){
    if slot == 0 { return floor(daily * 0.30) }
    floor(daily * 0.40)
}
fn prepare_week_agent_offers(){
    weekAgentOffers = []
    let seenDates = []
    let summary = ""
    for i in weekDraft.len() {
        if weekAgentOffers.len() >= 5 { break }
        let choice = weekDraft[i]
        let seen = false
        for date in seenDates { if date == choice.date { seen = true } }
        if seen { continue }
        let original = allProducts[choice.product_id]
        let alternatives = []
        let sampleCount = min(90, allProducts.len())
        for sample in sampleCount {
            let id = (choice.product_id + sample * 37 + i * 31) % allProducts.len()
            let p = allProducts[id]
            if p.cents <= original.cents && p.name != original.name && matches_meal_for(p, choice.slot)
                && open_at(p.business_hours, clock_value(defaultTimes[choice.slot])) {
                let duplicate = false
                for old in alternatives { if allProducts[old].name == p.name { duplicate = true } }
                if !duplicate { alternatives.push(id) }
                if alternatives.len() >= 2 { break }
            }
        }
        if alternatives.len() > 0 {
            seenDates.push(choice.date)
            weekAgentOffers.push({draft_index: i alternatives: alternatives})
            summary += "" + weekAgentOffers.len() + ". " + choice.date + " " + slot_label(choice.slot) + ": " + original.name + " ¥" + cash(original.cents) + "\n"
            for j in alternatives.len() {
                let replacement = allProducts[alternatives[j]]
                summary += "   " + (j + 1) + ") " + replacement.name + " ¥" + cash(replacement.cents)
                    + " · " + replacement.store + " · " + replacement.business_hours + "\n"
            }
        }
    }
    if summary == "" { summary = L("当前草案没有可核验的换餐选项，仍可手动逐餐调整。", "No valid swaps found; you can still edit meals manually.") }
    ui.week_agent_options.set_text(summary)
    clear_week_agent_proposal()
}
fn ask_week_agent(){
    if weekAgentBusy { return }
    if weekDraft.len() == 0 || weekAgentOffers.len() == 0 || weekDraftRevision != journal.revision
        || weekDraftStart != currentDate || weekDraftProfileDaily != profileDaily {
        ui.week_agent_result.set_text(L("草案或换餐选项已失效，请重新生成。", "Draft or swap options expired. Generate again."))
        return
    }
    let request = ui.week_agent_request.text().trim()
    if request == "" {
        ui.week_agent_result.set_text(L("先写下这周想怎么调整。", "Describe the change you want first."))
        return
    }
    let stamp = week_draft_stamp()
    let prompt = L("你是七日食堂餐表调整助手。只可从下列已验证的日期和餐品选项中提议调整，每个日期最多选择一个替代品。不能编造菜单、价格、营业时段、营养或过敏安全事实。", "You help adjust a seven-day canteen draft. Select only from the verified dates and meal alternatives, at most one per date. Do not invent menu, price, hours, nutrition or allergy facts. Reply in English. ")
        + L("用户希望：", "User request: ") + request + L("。已确认餐次不在本次可改范围。\n", ". Confirmed meals are outside this draft.\n")
        + ui.week_agent_options.text()
        + L("仅返回 JSON：{\"changes\":[{\"meal\":\"选项列表中列出的日期文本\",\"option\":替代品编号}],\"reason\":\"简短取舍理由\"}；meal 必须逐字复制列表中的日期，不能满足需求则返回空数组并解释。", "Return JSON only: {\"changes\":[{\"meal\":\"the date text listed in the options\",\"option\":alternative_number}],\"reason\":\"brief rationale\"}; meal must copy the listed date verbatim. Return an empty array if the options cannot address the request.")
    weekAgentRequest += 1
    let requestId = weekAgentRequest
    weekAgentBusy = true
    weekAgentChanges = []
    weekAgentStamp = ""
    ui.week_agent_result.set_text(L("正在请 OctoSense Agent 比较本周换餐…", "Asking the OctoSense Agent to compare swaps…"))
    host.request("octos.turn.start", {text: prompt}, fn(r){
        if requestId != weekAgentRequest { return }
        weekAgentBusy = false
        if stamp != week_draft_stamp() || weekDraftRevision != journal.revision {
            ui.week_agent_result.set_text(L("草案或需求已变化，旧建议已丢弃。", "Draft or request changed; old advice discarded."))
            return
        }
        if !r.is_ok {
            ui.week_agent_result.set_text(L("系统 Agent 暂不可用：", "System Agent unavailable: ") + r.error + L("。原草案可继续人工核对。", ". The original draft remains available."))
            return
        }
        try { fs.write("agent-week-last-reply.txt", r.data.text) } { }
        let crashed = false
        let parse_note = ""
        let answer = nil
        try {
            answer = r.data.text.parse_json()
            if answer == nil { parse_note = "direct-nil" }
        } { answer = nil; parse_note = "direct-threw" }
        if answer != nil && answer.is_object() {
            let has = false
            try { has = answer.changes != nil } { has = false }
            if has { parse_note = parse_note + " direct-has-changes" } else { parse_note = parse_note + " direct-no-changes" }
        }
        else { parse_note = parse_note + " direct-not-object" }
        let parts = nil
        try { parts = r.data.text.split("```") } { parts = nil; parse_note = parse_note + " split-threw" }
        if parts == nil { parts = [] }
        parse_note = parse_note + " parts=" + parts.len()
        let usable = false
        try { usable = answer != nil && answer.is_object() && answer.changes != nil } { usable = false }
        for seg in parts {
            if !usable {
                let piece = seg.trim()
                let stripped = nil
                try { stripped = piece.strip_prefix("json") } { stripped = nil }
                if stripped != nil { piece = stripped.trim() }
                if piece != "" {
                    let cand = nil
                    try { cand = piece.parse_json() } { cand = nil }
                    let candOk = false
                    try { candOk = cand != nil && cand.is_object() && cand.changes != nil } { candOk = false }
                    parse_note = parse_note + " [piece-len:" + piece.len() + " ok:" + candOk + "]"
                    if !candOk {
                        let detagged = piece.replace("json", "")
                        detagged = detagged.replace("JSON", "").trim()
                        try { cand = detagged.parse_json() } { cand = nil }
                        try { candOk = cand != nil && cand.is_object() && cand.changes != nil } { candOk = false }
                        parse_note = parse_note + " [detagged-ok:" + candOk + "]"
                    }
                    if candOk { answer = cand; usable = true }
                }
            }
        }
        parse_note = parse_note + " final-usable=" + usable
        try { fs.write("agent-week-notes.txt", "NOTES " + parse_note) } { }
        if !usable {
            ui.week_agent_result.set_text(L("Agent 回复格式无法核验，草案未改变。", "Invalid Agent response; draft unchanged."))
            try { fs.write("agent-week-fail.txt", "PARSE-FAILED raw=" + r.data.text.to_json()) } { }
            return
        }
        try { fs.write("agent-week-debug.txt", "PARSE-OK answer=" + answer.to_json()) } { }
        try { fs.write("agent-week-notes.txt", "NOTES " + parse_note) } { }
        let raw = nil
        let reason = nil
        try { raw = answer.changes reason = answer.reason } { raw = nil }
        if raw == nil || !raw.is_array() || raw.len() > weekAgentOffers.len() || reason == nil || !reason.is_string() {
            ui.week_agent_result.set_text(L("Agent 换餐编号或理由无效，草案未改变。", "Invalid swap list or rationale; draft unchanged."))
            return
        }
        let selected = []
        let dbg = ""
        for item in raw {
            let meal = nil
            let option = nil
            if item != nil && item.is_object() { try { meal = item.meal option = item.option } {} }
            if meal != nil && meal.is_string() {
                let matched = 0
                for k in weekAgentOffers.len() {
                    let choice = weekDraft[weekAgentOffers[k].draft_index]
                    let daySlot = choice.date + " " + slot_label(choice.slot)
                    if meal.search(daySlot) >= 0 { matched = k + 1 }
                }
                if matched == 0 {
                    for k in weekAgentOffers.len() {
                        let choice = weekDraft[weekAgentOffers[k].draft_index]
                        if meal.search(choice.date) >= 0 { matched = k + 1 }
                    }
                }
                if matched > 0 { meal = matched }
            }
            if option != nil && option.is_string() {
                let asNumber = option.to_f64()
                if asNumber != nil && asNumber > 0 { option = asNumber }
            }
            try { dbg += "meal=" + meal.to_json() + " option=" + option.to_json() + " offers=["; for k in weekAgentOffers.len() { let c = weekDraft[weekAgentOffers[k].draft_index]; dbg += c.date + "/" + slot_label(c.slot) + "," } dbg += "]\n" } { }
            try { fs.write("agent-week-debug.txt", dbg) } { }
            if meal == nil || option == nil || !meal.is_number() || !option.is_number()
                || meal != floor(meal) || option != floor(option) || meal < 1 || meal > weekAgentOffers.len() {
                ui.week_agent_result.set_text(L("Agent 餐次或选项编号无效，草案未改变。", "Invalid meal or option number; draft unchanged."))
                return
            }
            let offer = weekAgentOffers[meal - 1]
            if option < 1 || option > offer.alternatives.len() {
                ui.week_agent_result.set_text(L("Agent 选项不在可选范围内，草案未改变。", "Option out of range; draft unchanged."))
                return
            }
            for old in selected {
                if old.meal == meal {
                    ui.week_agent_result.set_text(L("Agent 重复选择同一日期，草案未改变。", "Duplicate date; draft unchanged."))
                    return
                }
            }
            selected.push({meal: meal option: option})
        }
        if reason.len() > 300 { reason = L("理由过长，已省略", "Rationale too long; omitted") }
        weekAgentChanges = selected
        weekAgentStamp = stamp
        if selected.len() == 0 {
            ui.week_agent_result.set_text(L("Agent 建议不换餐：", "Agent suggests no swap: ") + reason + L("。草案未改变。", ". Draft unchanged."))
        } else {
            let changes = ""
            for change in selected {
                let offer = weekAgentOffers[change.meal - 1]
                let choice = weekDraft[offer.draft_index]
                changes += choice.date + " " + slot_label(choice.slot) + ": " + allProducts[choice.product_id].name
                    + " → " + allProducts[offer.alternatives[change.option - 1]].name + "\n"
            }
            ui.week_agent_result.set_text(L("Agent 提议：\n", "Agent proposes:\n") + changes + L("理由：", "Reason: ") + reason
                + L("\n先应用到草案并核对，再确认整周保存。", "\nApply to the draft, review, then confirm the week."))
        }
    })
}
fn apply_week_agent(){
    if weekAgentChanges.len() == 0 || weekAgentStamp == "" || weekAgentStamp != week_draft_stamp()
        || weekDraftRevision != journal.revision || weekDraftStart != currentDate || weekDraftProfileDaily != profileDaily {
        clear_week_agent_proposal()
        ui.status.set_text(L("Agent 提案已失效，请重新请求。", "Agent proposal expired. Ask again."))
        return
    }
    let revised = weekDraft.to_json().parse_json()
    for change in weekAgentChanges {
        let offer = weekAgentOffers[change.meal - 1]
        let choice = revised[offer.draft_index]
        let original = allProducts[choice.product_id]
        let alternateId = offer.alternatives[change.option - 1]
        let alternate = allProducts[alternateId]
        if alternate.cents > original.cents || !matches_meal_for(alternate, choice.slot)
            || !open_at(alternate.business_hours, clock_value(defaultTimes[choice.slot])) {
            clear_week_agent_proposal()
            ui.status.set_text(L("换餐条件已变化，未修改草案。", "Swap no longer fits; draft unchanged."))
            return
        }
        revised[offer.draft_index].product_id = alternateId
    }
    let count = weekAgentChanges.len()
    weekDraft = revised
    weekAgentOffers = []
    clear_week_agent_proposal()
    ui.week_agent_options.set_text(L("建议已应用到待确认草案；如需新提案，请重新生成。", "Changes applied to the unconfirmed draft. Regenerate for new options."))
    ui.draft_items.render()
    ui.status.set_text(L("Agent 建议已调整草案中的 ", "Agent changed ") + count + L(" 餐；尚未保存，请逐项核对后确认整周。", " draft meals. Review and confirm the week to save."))
}
fn generate_week_draft(){
    clear_week_draft()
    if !storageReady { ui.status.set_text(L("记录无法读取，暂不能生成草案。", "Records unavailable; cannot make a draft.")) return }
    let target = next_meal_target()
    let chosen = []
    let chosenStores = []
    let gaps = 0
    let repeats = 0
    for offset in 7 {
        let date = week_date(currentDate, offset)
        let index = day_index(journal, date)
        let daily = profileDaily
        let tier = selectedTier
        let confirmed = []
        if index >= 0 {
            daily = journal.days[index].daily_cents
            tier = journal.days[index].tier
            confirmed = journal.days[index].meals
        } else if !profileReady { daily = tiers[selectedTier] }
        let remaining = daily - sum_meals(confirmed, -1)
        for slot in 3 {
            let already = false
            for meal in confirmed {
                if meal.slot == slot {
                    already = true
                    chosen.push(meal.product_id)
                    chosenStores.push(meal.store)
                }
            }
            if !already {
                let past = date < target.date || (date == target.date && slot < target.slot)
                if !past {
                    let cap = min(week_meal_limit(daily, slot), remaining)
                    let arrival = clock_value(defaultTimes[slot])
                    let best = -1
                    let bestScore = 999999
                    if cap >= 100 {
                        let sampleCount = min(60, allProducts.len())
                        if slot == 0 { sampleCount = breakfastPool.len() }
                        for sample in sampleCount {
                            let id = (sample * 37 + offset * 31 + slot * 17) % allProducts.len()
                            if slot == 0 { id = breakfastPool[sample] }
                            let p = allProducts[id]
                            if p.cents <= cap && matches_meal_for(p, slot) && open_at(p.business_hours, arrival) {
                                let score = abs(p.cents - round(cap * 0.75))
                                if regex("饭", "").test(p.name) { score -= 800 }
                                for old in chosen { if old == id { score += 3000 } }
                                for store in chosenStores { if store == p.store { score += 120 } }
                                if score < bestScore { bestScore = score best = id }
                            }
                        }
                    }
                    if best >= 0 {
                        let p = allProducts[best]
                        for old in chosen { if old == best { repeats += 1 break } }
                        weekDraft.push({date: date slot: slot product_id: best daily_cents: daily tier: tier})
                        chosen.push(best)
                        chosenStores.push(p.store)
                        remaining -= p.cents
                    } else { gaps += 1 }
                }
            }
        }
    }
    if weekDraft.len() == 0 {
        ui.status.set_text(L("本周没有可新增的餐次；请检查已确认计划或预算。", "No new meals fit this week; check existing plans or budget."))
        return
    }
    weekDraftRevision = journal.revision
    weekDraftStart = currentDate
    weekDraftProfileDaily = profileDaily
    ui.draft_panel.set_visible(true)
    ui.draft_summary.set_text(L("待确认 ", "Review ") + weekDraft.len() + L(" 餐，缺口 ", " meals; gaps ") + gaps + L(" 餐，重复 ", "; repeats ") + repeats + L(" 次。草案不会自动覆盖已确认计划。", ". The draft will not replace confirmed meals."))
    ui.draft_items.render()
    ui.status.set_text(L("已生成七天草案，请逐项核对；确认前不会写入餐表。", "Seven-day draft ready. Review it; nothing is saved until confirmation."))
    start_timeout(0.05, || prepare_week_agent_offers())
}
fn confirm_week_draft(){
    if weekDraft.len() == 0 || weekDraftRevision != journal.revision || weekDraftStart != currentDate || weekDraftProfileDaily != profileDaily {
        clear_week_draft()
        ui.status.set_text(L("草案已过期，请重新生成。", "Draft expired. Generate it again."))
        return
    }
    let next = journal.to_json().parse_json()
    for choice in weekDraft {
        let d = day_index(next, choice.date)
        if d < 0 {
            if next.days.len() >= 90 { ui.status.set_text(L("已达到 90 天记录上限，草案未保存。", "90-day record limit reached; draft not saved.")) return }
            next.days.push({date: choice.date daily_cents: choice.daily_cents tier: choice.tier meals: []})
            d = next.days.len() - 1
        }
        let taken = false
        for meal in next.days[d].meals { if meal.slot == choice.slot { taken = true } }
        if taken { clear_week_draft() ui.status.set_text(L("已有餐次变化，草案已作废。", "A meal changed; draft discarded.")) return }
        let p = allProducts[choice.product_id]
        let cap = min(week_meal_limit(next.days[d].daily_cents, choice.slot), next.days[d].daily_cents - sum_meals(next.days[d].meals, -1))
        let arrival = defaultTimes[choice.slot]
        if p.cents > cap || !matches_meal_for(p, choice.slot) || !open_at(p.business_hours, clock_value(arrival)) {
            clear_week_draft()
            ui.status.set_text(L("有草案餐次已不符合预算或时段，未保存。", "A draft meal no longer fits budget or hours; nothing was saved."))
            return
        }
        next.days[d].meals.push({slot: choice.slot product_id: choice.product_id cents: p.cents name: p.name store: p.store hours: p.business_hours arrival: arrival note: "" saved_at: time_now()})
    }
    next.last_date = currentDate
    let count = weekDraft.len()
    if store_record(next) {
        clear_week_draft()
        hide_candidates()
        refresh_summary()
        ui.plans.render()
        ui.status.set_text(L("已确认并读回核验 ", "Confirmed and verified ") + count + L(" 餐；仅为计划，未下单。", " planned meals; no orders placed."))
    }
}
fn ask_agent(){
    if agentBusy { return }
    if candidates.len() == 0 || candidateStamp == "" || candidateStamp != selection_stamp() {
        ui.agent_result.set_text(L("候选已失效，请重新查找。", "Options expired. Search again."))
        return
    }
    let condition = read_conditions()
    if condition == nil {
        agentChoice = -1
        agentStamp = ""
        ui.agent_result.set_text(L("当前条件已不可用，请重新查找候选。", "Current settings are invalid. Find options again."))
        return
    }
    agentRequest += 1
    let requestId = agentRequest
    let stamp = candidateStamp
    let options = ""
    for candidateIndex in candidates.len() {
        let i = candidates[candidateIndex]
        let p = allProducts[i]
        options += L("候选 ", "Option ") + (candidateIndex + 1) + ": id=" + i + "; " + p.name + "; ¥" + cash(p.cents) + "; " + p.store + L("；时段 ", "; hours ") + p.business_hours + ".\n"
    }
    let prior = L("无", "none")
    for m in current_meals() { prior += "; " + slot_label(m.slot) + " " + m.name + " ¥" + cash(m.cents) }
    let prompt = L("你是餐饮候选比较助手。只能比较给出的候选，不能编造价格、菜品、营业信息或营养过敏事实。\n", "You compare meal options. Only use the supplied options. Do not invent prices, dishes, hours, nutrition or allergen facts. Reply in English. Menu names remain in their original Chinese.\n")
        + L("用户餐次：", "Meal: ") + slot_label(selectedSlot) + L("；日预算 ¥", "; daily budget ¥") + cash(money_value(ui.daily.text()))
        + L("；本餐可用上限 ¥", "; meal limit ¥") + cash(condition.cap) + L("；到店时间 ", "; arrival ") + ui.arrival.text()
        + L("；用户需求：", "; request: ") + ui.request.text() + L("；当天已计划：", "; existing plans: ") + prior + ".\n"
        + L("候选如下：\n", "Options:\n") + options
        + L("仅返回 JSON：{\"choice\":候选序号(从1开始，无法推荐则0),\"reason\":\"简短取舍理由\"}。不要提供其他文本。", "Return JSON only: {\"choice\":option number starting at 1, or 0 if none,\"reason\":\"brief rationale\"}. No other text.")
    agentChoice = -1
    agentStamp = ""
    ui.agent_result.set_text(L("正在请求 OctoSense 系统 Agent…", "Asking the OctoSense system Agent…"))
    agentBusy = true
    host.request("octos.turn.start", {text: prompt}, fn(r){
        if requestId != agentRequest { return }
        agentBusy = false
        if stamp != candidateStamp || stamp != selection_stamp() {
            agentChoice = -1
            agentStamp = ""
            ui.agent_result.set_text(L("条件已变化；这次 Agent 结果已丢弃，请重新查找。", "Settings changed. This Agent response was discarded; search again."))
            return
        }
        if !r.is_ok {
            agentChoice = -1
            agentStamp = ""
            ui.agent_result.set_text(L("系统 Agent 暂不可用：", "System Agent unavailable: ") + r.error + L("。你仍可自行选择候选。", ". You can still choose an option yourself."))
            return
        }
        let answer = nil
        try { answer = r.data.text.parse_json() } { answer = nil }
        if !answer.is_object() {
            agentChoice = -1
            agentStamp = ""
            ui.agent_result.set_text(L("Agent 已回复，但建议格式无法核验。请自行查看候选。", "The Agent replied in an invalid format. Review the options yourself."))
            return
        }
        let choice = -1
        try {
            let value = answer.choice
            if value.is_number() { choice = value }
        } { choice = -1 }
        if !(choice >= 0 && choice <= candidates.len() && choice == floor(choice)) {
            agentChoice = -1
            agentStamp = ""
            ui.agent_result.set_text(L("Agent 已回复，但建议格式无法核验。请自行查看候选。", "The Agent replied in an invalid format. Review the options yourself."))
            return
        }
        if choice == 0 {
            agentChoice = -1
            agentStamp = ""
            ui.agent_result.set_text(L("Agent 没有选出合适候选；你仍可自行判断。", "The Agent found no suitable option. You can still decide yourself."))
            return
        }
        let reason = L("未提供取舍理由", "No rationale provided")
        try {
            let value = answer.reason
            if value.is_string() { reason = value }
        } { reason = L("未提供取舍理由", "No rationale provided") }
        if reason.len() > 300 { reason = L("理由过长，已省略", "Rationale too long; omitted") }
        agentChoice = choice - 1
        agentStamp = stamp
        ui.agent_result.set_text(L("Agent 建议候选 ", "Agent suggests option ") + choice + ": " + reason + L("\n仅为建议；请核对信息并自行确认。", "\nSuggestion only. Check details and confirm yourself."))
        ui.choices.render()
    })
}
fn cancel_meal(slot){
    let d = day_index(journal, currentDate)
    if d < 0 { return }
    let next = journal.to_json().parse_json()
    let kept = []
    for m in next.days[d].meals {
        if m.slot == slot && meal_eaten_at(m) != nil { ui.status.set_text(L("请先撤销已吃记录，再取消这餐。", "Undo the eaten record before cancelling this meal.")) return }
        if m.slot != slot { kept.push(m) }
    }
    next.days[d].meals = kept
    next.last_date = currentDate
    if store_record(next) {
        hide_candidates()
        ui.daily.set_text(cash(next.days[d].daily_cents))
        refresh_summary()
        ui.plans.render()
        ui.status.set_text(L("已取消", "Cancelled ") + slot_label(slot) + L("，计划金额已更新并核验。", "; planned total updated and verified."))
    }
}
fn edit_meal(slot){
    for meal in current_meals() {
        if meal.slot == slot && meal_eaten_at(meal) != nil {
            ui.status.set_text(L("请先撤销已吃记录，再修改这餐。", "Undo the eaten record before editing this meal."))
            return
        }
    }
    apply_slot(slot)
    for m in current_meals() {
        if m.slot == slot { ui.arrival.set_text(m.arrival) ui.request.set_text(m.note) }
    }
    show_page(false)
    ui.status.set_text(L("正在修改", "Editing ") + slot_label(slot) + L("。确认新候选前，旧计划继续保留。", ". The existing meal stays until a replacement is confirmed."))
}
fn begin_checkin(slot){
    let index = day_index(journal, currentDate)
    if index < 0 || currentDate != today() { return }
    for meal in journal.days[index].meals {
        if meal.slot == slot && meal_eaten_at(meal) == nil {
            checkinDate = currentDate
            checkinSlot = slot
            ui.actual_price.set_text(cash(meal.cents))
            ui.checkin_hint.set_text(slot_label(slot) + " · " + meal.name + L("。请核对实际支付金额。", ". Check the amount you actually paid."))
            ui.checkin.set_visible(true)
            ui.status.set_text(L("请核对金额，再点确认已吃。", "Check the amount, then save the eaten meal."))
            return
        }
    }
}
fn confirm_checkin(){
    if checkinSlot < 0 || checkinDate != currentDate || currentDate != today() { return }
    let actual = money_value(ui.actual_price.text())
    if actual < 0 { ui.status.set_text(L("实际支付金额须为 ¥1–500，最多两位小数。", "Amount paid must be ¥1–500 with at most two decimals.")) return }
    let next = journal.to_json().parse_json()
    let d = day_index(next, checkinDate)
    if d < 0 { return }
    let found = false
    for m in next.days[d].meals {
        if m.slot == checkinSlot && meal_eaten_at(m) == nil {
            m.eaten_at = time_now()
            m.actual_cents = actual
            found = true
        }
    }
    if !found { return }
    next.last_date = currentDate
    if store_record(next) {
        checkinSlot = -1
        checkinDate = ""
        ui.checkin.set_visible(false)
        hide_candidates()
        refresh_summary()
        ui.plans.render()
        let status = L("已记录吃过及实际支付 ¥", "Meal eaten; amount paid ¥") + cash(actual) + L("，并读回核验。", "; saved and verified.")
        let d = day_index(journal, currentDate)
        if d >= 0 && sum_meals(journal.days[d].meals, -1) > journal.days[d].daily_cents {
            status += L(" 当日已超支，请检查待吃计划。", " The day is over budget; review upcoming meals.")
        }
        ui.status.set_text(status)
    }
}
fn undo_checkin(slot){
    let d = day_index(journal, currentDate)
    if d < 0 { return }
    let next = journal.to_json().parse_json()
    let found = false
    for m in next.days[d].meals {
        if m.slot == slot && meal_eaten_at(m) != nil {
            m.eaten_at = nil
            m.actual_cents = nil
            found = true
        }
    }
    if !found { return }
    next.last_date = currentDate
    if store_record(next) {
        refresh_summary()
        ui.plans.render()
        ui.status.set_text(L("已撤销用餐记录，餐表计划仍保留。", "Eaten record undone; the meal plan remains."))
    }
}
fn save_budget(){
    if ui.date.text().trim() != currentDate { ui.status.set_text(L("请先打开输入的日期。", "Open the entered date first.")) return }
    let daily = money_value(ui.daily.text())
    if daily < 0 { ui.status.set_text(L("日预算需为 1–500 元、最多两位小数。", "Daily budget must be ¥1–500 with at most two decimals.")) return }
    if daily < sum_meals(current_meals(), -1) { ui.status.set_text(L("新预算低于已计划金额，请先修改或取消餐次。", "New budget is below planned cost. Change or cancel meals first.")) return }
    let next = prepare_day(daily)
    if next == nil { return }
    if store_record(next) { invalidate() ui.status.set_text(L("日预算已保存并读回核验。", "Daily budget saved and read back.")) }
}
fn boot(){
    if fs.exists("language.json") {
        try { english = fs.read("language.json").parse_json().lang == "en" } { english = false }
    }
    let profile = nil
    let customMenuBroken = false
    if fs.exists("profile.json") {
        try { profile = fs.read("profile.json").parse_json() } { profile = nil }
        if profile != nil {
            let custom = false
            try { custom = profile.menu == "custom-v1" } { custom = false }
            if custom {
                let imported = nil
                try { imported = fs.read("custom-menu.json").parse_json() } { imported = nil }
                if valid_custom_menu(imported) {
                    allProducts = imported.products
                    breakfastPool = imported.breakfast_pool
                    menuKind = "custom-v1"
                    menuSource = imported.source
                    menuUpdated = imported.updated
                    menuTimezone = imported.timezone_minutes
                } else { customMenuBroken = true }
            }
        }
    }
    let a = nil
    let b = nil
    let existsA = fs.exists("plans-a.json")
    let existsB = fs.exists("plans-b.json")
    if existsA { a = read_record("plans-a.json") }
    if existsB { b = read_record("plans-b.json") }
    if a != nil { journal = a activeFile = "plans-a.json" }
    if b != nil { if b.revision > journal.revision { journal = b activeFile = "plans-b.json" } }
    if profile != nil && !customMenuBroken {
        try {
            let p = profile
            if p.schema == 1 && p.menu == menuKind && p.daily_cents >= 100 && p.daily_cents <= 50000
                && p.monthly_cents >= p.fixed_cents + p.reserve_cents + p.daily_cents * 30 {
                profileDaily = p.daily_cents
                profileReady = true
                ui.setup_monthly.set_text(cash(p.monthly_cents))
                ui.setup_fixed.set_text(cash(p.fixed_cents))
                ui.setup_reserve.set_text(cash(p.reserve_cents))
            }
        } { profileReady = false }
    }
    currentDate = today()
    ui.date.set_text(currentDate)
    if profileReady || journal.days.len() > 0 { show_home() }
    else { show_setup() }
    if profileReady || journal.days.len() > 0 { go_next_meal() }
    else { open_date() }
    if !profileReady && journal.days.len() == 0 { show_setup() }
    if customMenuBroken {
        storageReady = false
        ui.status.set_text(L("自定义菜单缺失或损坏，已暂停保存；请恢复原文件。", "Custom menu missing or damaged. Saving paused; restore the file."))
    } else if (existsA || existsB) && activeFile == "" {
        storageReady = false
        ui.status.set_text(L("记录损坏或无法读取，已暂停保存，原文件保持不变。", "Records are damaged or unreadable. Saving is paused; files are unchanged."))
    } else {
        if (existsA && a == nil) || (existsB && b == nil) { ui.status.set_text(L("一份记录不可用，已恢复另一份有效记录。请核对计划。", "One copy was unreadable. Restored another valid record; please review the plan.")) }
        else { ui.status.set_text(L("本地规划已就绪。先查找候选，再确认保存。", "Local planning is ready. Find options, then confirm a meal.")) }
    }
    refresh_language()
}

start_timeout(0.05, || boot())
