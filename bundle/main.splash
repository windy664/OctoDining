fn L(zh, en){ if english { return en } zh }
fn home_day_label(){
    if currentDate == today() { return L("今天", "Today") }
    L("明天", "Tomorrow")
}
fn slot_label(slot){
    if english { let names = ["Breakfast" "Lunch" "Dinner"] return names[slot] }
    slotNames[slot]
}

fn cash(cents){
    if cents < 0 { return "-" + cash(-cents) }
    let whole = floor(cents / 100)
    let tail = cents - whole * 100
    let decimal = "" + tail
    if tail < 10 { decimal = "0" + decimal }
    "" + whole + "." + decimal
}
fn pad(n){ if n < 10 { return "0" + n } "" + n }
fn week_date(start, offset){
    let p = start.split("-")
    let y = p[0].to_f64()
    let m = p[1].to_f64()
    let d = p[2].to_f64()
    for step in offset {
        let days = [31 28 31 30 31 30 31 31 30 31 30 31]
        if y % 4 == 0 && (y % 100 != 0 || y % 400 == 0) { days[1] = 29 }
        d += 1
        if d > days[m - 1] {
            d = 1
            m += 1
            if m > 12 { m = 1 y += 1 }
        }
    }
    "" + y + "-" + pad(m) + "-" + pad(d)
}
fn canteen_time(){
    // The bundled canteen is in Guangzhou (UTC+8). card-host defaults to UTC,
    // while a Shell may provide its own local offset. Infer that offset from
    // the epoch so both hosts show the same canteen-local meal and date.
    let epoch = local_time(0)
    let host_offset = epoch.hour * 60 + epoch.minute
    if epoch.day == 31 { host_offset -= 1440 }
    local_time(time_now() + (menuTimezone - host_offset) * 60)
}
fn today(){
    let d = canteen_time()
    "" + d.year + "-" + pad(d.month) + "-" + pad(d.day)
}
fn next_meal_target(){
    let now = canteen_time()
    let minute = now.hour * 60 + now.minute
    let date = today()
    let slot = 0
    if minute >= 600 { slot = 1 }
    if minute >= 840 { slot = 2 }
    if minute >= 1200 { date = week_date(date, 1) slot = 0 }
    for attempt in 4 {
        let eaten = false
        let index = day_index(journal, date)
        if index >= 0 {
            for meal in journal.days[index].meals {
                if meal.slot == slot && meal_eaten_at(meal) != nil { eaten = true }
            }
        }
        if !eaten { return {date: date slot: slot} }
        slot += 1
        if slot > 2 { date = week_date(date, 1) slot = 0 }
    }
    {date: date slot: slot}
}
fn valid_date(text){
    if !regex("^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "").test(text) { return false }
    let p = text.split("-")
    let y = p[0].to_f64()
    let m = p[1].to_f64()
    let d = p[2].to_f64()
    if y < 2000 || y > 2100 || m < 1 || m > 12 { return false }
    let monthDays = [31 28 31 30 31 30 31 31 30 31 30 31]
    if y % 4 == 0 && (y % 100 != 0 || y % 400 == 0) { monthDays[1] = 29 }
    d >= 1 && d <= monthDays[m - 1]
}
fn clock_value(text){
    if !regex("^[0-9]{2}:[0-9]{2}$", "").test(text) { return -1 }
    let p = text.split(":")
    let h = p[0].to_f64()
    let m = p[1].to_f64()
    if h >= 24 || m >= 60 { return -1 }
    h * 60 + m
}
fn money_value(text){
    let s = text.trim()
    if !regex("^[0-9]+([.][0-9]{1,2})?$", "").test(s) { return -1 }
    let n = round(s.to_f64() * 100)
    if !(n >= 100 && n <= 50000) { return -1 }
    n
}
fn monthly_value(text){
    let s = text.trim()
    if !regex("^[0-9]+([.][0-9]{1,2})?$", "").test(s) { return -1 }
    let n = round(s.to_f64() * 100)
    if !(n >= 0 && n <= 5000000) { return -1 }
    n
}
fn open_at(hours, current){
    if hours == "" || hours == "未设置" { return false }
    for period in hours.split(",") {
        let parts = period.trim().split("-")
        if parts.len() == 2 {
            let a = clock_value(parts[0].trim())
            let b = clock_value(parts[1].trim())
            if a >= 0 && b >= 0 {
                if a < b && current >= a && current < b { return true }
                if a > b && (current >= a || current < b) { return true }
            }
        }
    }
    false
}
fn matches_meal_for(p, slot){
    let text = p.name + " " + p.category
    if regex("勿点|专用|补差|打包费|餐具|加料|加粉|加饭|加面|配菜|小料|升级", "").test(text) { return false }
    if slot == 0 {
        return regex("包子|馒头|粥|肠粉|油条|饺|馄饨|云吞|三明治|鸡蛋|煎蛋", "").test(text)
            && !regex("饮|奶茶|果切|水果|咖啡|甜品|蛋糕|豆浆|牛奶|加料", "").test(text)
            && !regex("^鸡蛋$|^煎蛋$|^煎鸡蛋$|^鸡蛋泥$|^肉沫干蒸鸡蛋$", "").test(p.name)
    }
    regex("饭|粉|面|米线|馄饨|云吞|饺子|套餐|堡", "").test(text)
        && regex("肉|鸡|鸭|猪|牛|鱼|虾|蛋|肘|排骨|叉烧|云吞|饺|腊|煲仔|麻婆", "").test(p.name)
        && !regex("饮|奶茶|果切|水果|咖啡|甜品|蛋糕|面包|早餐|粥类|豆浆|油条|斋|清汤|青菜|白饭|米饭|单点|小份|半份|小碗", "").test(text)
        && p.cents >= 800
}
fn matches_meal(p){ matches_meal_for(p, selectedSlot) }
fn valid_custom_menu(doc){
    if !doc.is_object() { return false }
    let valid = false
    try {
        valid = doc.schema == 1 && doc.source.is_string() && doc.source.trim() != "" && doc.source.len() <= 100
            && doc.updated.is_string() && valid_date(doc.updated)
            && doc.products.is_array() && doc.products.len() >= 3 && doc.products.len() <= 200
            && doc.breakfast_pool.is_array()
            && doc.timezone_minutes >= -720 && doc.timezone_minutes <= 840
            && doc.timezone_minutes == floor(doc.timezone_minutes)
    } { valid = false }
    if !valid { return false }
    let keys = []
    for product in doc.products {
        let good = false
        try {
            good = product.name.is_string() && product.name.trim() != "" && product.name.len() <= 100
                && product.store.is_string() && product.store.trim() != "" && product.store.len() <= 100
                && product.category.is_string() && product.category.len() <= 80
                && product.business_hours.is_string() && product.business_hours.len() <= 120
                && product.image_url == ""
                && product.cents >= 100 && product.cents <= 50000 && product.cents == floor(product.cents)
        } { good = false }
        if !good { return false }
        let hoursGood = false
        for period in product.business_hours.split(",") {
            let parts = period.trim().split("-")
            if parts.len() != 2 { return false }
            let start = clock_value(parts[0].trim())
            let end = clock_value(parts[1].trim())
            if start < 0 || end < 0 || start == end { return false }
            hoursGood = true
        }
        if !hoursGood { return false }
        let key = product.store + "|" + product.name + "|" + product.business_hours
        for old in keys { if old == key { return false } }
        keys.push(key)
    }
    for id in doc.breakfast_pool {
        if !(id >= 0 && id < doc.products.len()) || id != floor(id) { return false }
    }
    true
}
fn import_custom_menu(){
    if profileReady || journal.days.len() > 0 {
        ui.setup_import_result.set_text(L("已有餐表。为保护商品 ID 与历史记录，请在新的应用数据空间导入另一份菜单。", "Existing plans use menu IDs. Import another menu in a fresh app data space."))
        return
    }
    let source = ui.setup_import_source.text().trim()
    let updated = ui.setup_import_date.text().trim()
    let timezone = ui.setup_import_timezone.text().trim().to_f64()
    let raw = ui.setup_import_json.text().trim()
    if source == "" || source.len() > 100 || !valid_date(updated) || raw.len() > 150000 || !(timezone >= -12 && timezone <= 14) || timezone != floor(timezone) {
        ui.setup_import_result.set_text(L("填写来源、更新日期、UTC 时区（-12 至 +14），并粘贴不超过 150 KB 的 JSON 菜单。", "Enter source, update date, UTC offset (-12 to +14), and at most 150 KB of JSON."))
        return
    }
    let rows = raw.parse_json()
    if !rows.is_array() || rows.len() < 3 || rows.len() > 200 {
        ui.setup_import_result.set_text(L("菜单须是含 3–200 条商品的 JSON 数组。", "Menu must be a JSON array of 3–200 items."))
        return
    }
    let products = []
    let pool = []
    for row in rows {
        let good = false
        let product = nil
        try {
            product = {name: row.name store: row.store category: row.category business_hours: row.business_hours cents: row.cents image_url: ""}
            good = true
        } { good = false }
        if !good {
            ui.setup_import_result.set_text(L("有商品缺少 name、store、category、business_hours 或 cents 字段。", "An item is missing a required field."))
            return
        }
        products.push(product)
        if regex("包子|馒头|粥|肠粉|油条|饺|馄饨|云吞|三明治|鸡蛋|煎蛋", "").test(product.name + " " + product.category)
            && open_at(product.business_hours, clock_value("08:00")) { pool.push(products.len() - 1) }
    }
    let doc = {schema: 1 source: source updated: updated timezone_minutes: timezone * 60 products: products breakfast_pool: pool}
    if !valid_custom_menu(doc) {
        ui.setup_import_result.set_text(L("导入失败：请检查价格（整数分）、营业时段、重复商品及图片字段。原菜单保留。", "Import failed: check prices in cents, hours, duplicates and fields. Existing menu kept."))
        return
    }
    let saved = false
    try {
        fs.write("custom-menu.json", doc.to_json())
        let checked = fs.read("custom-menu.json").parse_json()
        if valid_custom_menu(checked) { saved = true }
    } { saved = false }
    if !saved {
        ui.setup_import_result.set_text(L("菜单未能保存并读回，原菜单保留。", "Menu could not be saved and read back; existing menu kept."))
        return
    }
    allProducts = products
    breakfastPool = pool
    menuKind = "custom-v1"
    menuSource = source
    menuUpdated = updated
    menuTimezone = timezone * 60
    ui.setup_menu_info.set_text(L("已导入：", "Imported: ") + source + " · " + updated + L(" · ", " · ") + products.len() + L(" 道餐品", " items"))
    ui.setup_import_result.set_text(L("菜单已验证并读回。继续完成预算设置后启用。", "Menu verified and read back. Finish budget setup to use it."))
}
fn day_index(doc, date){
    for i in doc.days.len() { if doc.days[i].date == date { return i } }
    -1
}
fn current_meals(){
    let i = day_index(journal, currentDate)
    if i < 0 { return [] }
    journal.days[i].meals
}
fn meal_eaten_at(meal){
    let value = nil
    try { value = meal.eaten_at } { value = nil }
    value
}
fn meal_actual_cents(meal){
    let value = nil
    try { value = meal.actual_cents } { value = nil }
    value
}
fn sum_meals(meals, omit){
    let amount = 0
    for m in meals {
        if m.slot != omit {
            if meal_eaten_at(m) != nil { amount += meal_actual_cents(m) }
            else { amount += m.cents }
        }
    }
    amount
}
fn record_valid(doc){
    if doc.schema != 1 || !(doc.revision >= 1) || doc.revision != floor(doc.revision) || !valid_date(doc.last_date) { return false }
    let stored_menu = nil
    try { stored_menu = doc.menu } { stored_menu = nil }
    if stored_menu != nil && stored_menu != menuKind { return false }
    if stored_menu == nil && menuKind != "gzis-snapshot" { return false }
    if doc.days.len() > 90 { return false }
    let dates = []
    for day in doc.days {
        if !valid_date(day.date) || !(day.daily_cents >= 100 && day.daily_cents <= 50000) || day.daily_cents != floor(day.daily_cents) { return false }
        if !(day.tier >= 0 && day.tier < 6) || day.tier != floor(day.tier) || day.meals.len() > 3 { return false }
        for date in dates { if date == day.date { return false } }
        dates.push(day.date)
        let slots = []
        let pending_total = 0
        for m in day.meals {
            if !(m.slot >= 0 && m.slot < 3) || m.slot != floor(m.slot) { return false }
            for s in slots { if s == m.slot { return false } }
            slots.push(m.slot)
            if !(m.product_id >= 0 && m.product_id < allProducts.len()) || m.product_id != floor(m.product_id) { return false }
            let product = allProducts[m.product_id]
            if m.cents != product.cents || m.name != product.name || m.store != product.store || m.hours != product.business_hours { return false }
            if clock_value(m.arrival) < 0 || !open_at(m.hours, clock_value(m.arrival)) || m.note.len() > 500 { return false }
            if !(m.saved_at >= 0) { return false }
            let eaten_at = meal_eaten_at(m)
            let actual_cents = meal_actual_cents(m)
            if eaten_at != nil {
                if !(eaten_at >= m.saved_at) || !(actual_cents >= 100 && actual_cents <= 50000) || actual_cents != floor(actual_cents) { return false }
            } else if actual_cents != nil { return false }
            if eaten_at == nil { pending_total += m.cents }
        }
        // A real payment can exceed the original allowance; the record is
        // still a fact and must remain readable. Pending plans stay bounded.
        if pending_total > day.daily_cents { return false }
    }
    day_index(doc, doc.last_date) >= 0
}
fn read_record(path){
    let result = nil
    try {
        let parsed = fs.read(path).parse_json()
        if record_valid(parsed) { result = parsed }
    } { result = nil }
    result
}
fn store_record(next){
    if !storageReady {
        ui.status.set_text(L("记录无法读取，已暂停保存。请先恢复有效的计划文件。", "Records cannot be read. Saving is paused until a valid plan file is restored."))
        return false
    }
    next.revision = journal.revision + 1
    next.menu = menuKind
    let target = "plans-a.json"
    if activeFile == target { target = "plans-b.json" }
    let written = false
    try {
        let text = next.to_json()
        fs.write(target, text)
        if fs.read(target) == text {
            let checked = read_record(target)
            if checked != nil { written = true }
        }
    } { written = false }
    if !written {
        ui.status.set_text(L("保存失败：未能写入并核验。上一份有效计划已保留，请检查存储后重试。", "Save failed verification. The previous valid plan remains; check storage and retry."))
        return false
    }
    journal = next
    activeFile = target
    return true
}
fn hide_candidates(){
    // Invalidate any outstanding assistant callback when its inputs/results
    // cease to be usable. A late callback must not lock a newer request.
    agentRequest += 1
    agentBusy = false
    candidates = []
    candidateStamp = ""
    agentChoice = -1
    agentStamp = ""
    ui.agent_result.set_text(L("先生成候选，再请系统 Agent 比较。", "Find options, then ask the system Agent to compare."))
    ui.choices.render()
}
fn invalidate(){
    hide_candidates()
    homeSkip = -1
    homeSeen = []
    clear_week_draft()
    if onHome { show_home() } else { show_page(false) }
    ui.status.set_text(L("条件已变化，请重新查找候选。已保存计划不变。", "Settings changed. Find new options; saved plans are unchanged."))
    refresh_summary()
}
