"饭类\",\"business_hours\":\"09:00-21:00\",\"is_open\":true,\"cents\":1200},{\"name\":\"麻婆肉沫豆腐饭\",\"price\":12.0,\"store\":\"昆吉双拼饭·沙县蒸饺·云吞\",\"category\":\"饭类\",\"business_hours\":\"09:00-21:00\",\"is_open\":true,\"cents\":1200}]"
let allProducts = menuJson.parse_json()
let tiers = [1500 2200 3200 4500 6500 10000]
let limits = "[[400,700,700],[600,1000,1000],[800,1400,1400],[1200,2000,2200],[1500,2800,3200],[2200,2200,2200]]".parse_json()
let slotNames = ["早餐" "午餐" "晚餐"]
let defaultTimes = ["08:00" "12:00" "18:30"]
let selectedTier = 2
let selectedSlot = 2
let currentDate = ""
let journal = {schema: 1 revision: 0 last_date: "" days: []}
let activeFile = ""
let storageReady = true
let candidates = []
let candidateStamp = ""
let searchCursor = 0
let lastSearch = ""
let agentRequest = 0
let agentBusy = false
let agentChoice = -1
let agentStamp = ""
let ink = #x1d2433
let muted = #x677185
let blue = #x315efb

fn cash(cents){
    if cents < 0 { return "-" + cash(-cents) }
    let whole = floor(cents / 100)
    let tail = cents - whole * 100
    let decimal = "" + tail
    if tail < 10 { decimal = "0" + decimal }
    "" + whole + "." + decimal
}
fn pad(n){ if n < 10 { return "0" + n } "" + n }
fn today(){
    let d = local_time()
    "" + d.year + "-" + pad(d.month) + "-" + pad(d.day)
}
fn valid_date(text){
    if !regex("^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "").test(text) { return false }
    let p = text.split("-")
    let y = p[0].to_f64()
    let m = p[1].to_f64()
    let d = p[2].to_f64()
    if y < 2000 || y > 2100 || m < 1 || m > 12 { return false }
    let monthDays = [31 28 31 30 31 30 31 31 30 31 30 31]
    if y % 4 == 0 && (y % 100 != 0 || y % 400 == 0) { monthDays[1] = 29 }
    d >= 1 && d <= monthDays[m - 1]
}
fn clock_value(text){
    if !regex("^[0-9]{2}:[0-9]{2}$", "").test(text) { return -1 }
    let p = text.split(":")
    let h = p[0].to_f64()
    let m = p[1].to_f64()
    if h >= 24 || m >= 60 { return -1 }
    h * 60 + m
}
fn money_value(text){
    let s = text.trim()
    if !regex("^[0-9]+([.][0-9]{1,2})?$", "").test(s) { return -1 }
    let n = round(s.to_f64() * 100)
    if !(n >= 100 && n <= 50000) { return -1 }
    n
}
fn open_at(hours, current){
    if hours == "" || hours == "未设置" { return false }
    for period in hours.split(",") {
        let parts = period.trim().split("-")
        if parts.len() == 2 {
            let a = clock_value(parts[0].trim())
            let b = clock_value(parts[1].trim())
            if a >= 0 && b >= 0 {
                if a < b && current >= a && current < b { return true }
                if a > b && (current >= a || current < b) { return true }
            }
        }
    }
    false
}
fn matches_meal(p){
    let text = p.name + " " + p.category
    if regex("勿点|专用|补差|打包费|餐具|加料|加粉|加饭|加面|配菜|小料", "").test(text) { return false }
    if selectedSlot == 0 {
        return regex("早餐|包子|馒头|粥|肠粉|豆浆|油条|面包|饺|馄饨|云吞|三明治", "").test(text)
    }
    regex("饭|粉|面|米线|馄饨|云吞|饺子|套餐|堡", "").test(text) && !regex("饮|奶茶|果切|水果|咖啡|甜品|蛋糕|面包|早餐|粥类|豆浆|油条", "").test(text)
}
fn day_index(doc, date){
    for i in doc.days.len() { if doc.days[i].date == date { return i } }
    -1
}
fn current_meals(){
    let i = day_index(journal, currentDate)
    if i < 0 { return [] }
    journal.days[i].meals
}
fn sum_meals(meals, omit){
    let amount = 0
    for m in meals { if m.slot != omit { amount += m.cents } }
    amount
}
fn record_valid(doc){
    if doc.schema != 1 || !(doc.revision >= 1) || doc.revision != floor(doc.revision) || !valid_date(doc.last_date) { return false }
    if doc.days.len() > 90 { return false }
    let dates = []
    for day in doc.days {
        if !valid_date(day.date) || !(day.daily_cents >= 100 && day.daily_cents <= 50000) || day.daily_cents != floor(day.daily_cents) { return false }
        if !(day.tier >= 0 && day.tier < 6) || day.tier != floor(day.tier) || day.meals.len() > 3 { return false }
        for date in dates { if date == day.date { return false } }
        dates.push(day.date)
        let slots = []
        for m in day.meals {
            if !(m.slot >= 0 && m.slot < 3) || m.slot != floor(m.slot) { return false }
            for s in slots { if s == m.slot { return false } }
            slots.push(m.slot)
            if !(m.product_id >= 0 && m.product_id < allProducts.len()) || m.product_id != floor(m.product_id) { return false }
            let product = allProducts[m.product_id]
            if m.cents != product.cents || m.name != product.name || m.store != product.store || m.hours != product.business_hours { return false }
            if clock_value(m.arrival) < 0 || !open_at(m.hours, clock_value(m.arrival)) || m.note.len() > 500 { return false }
            if !(m.saved_at >= 0) { return false }
        }
        if sum_meals(day.meals, -1) > day.daily_cents { return false }
    }
    day_index(doc, doc.last_date) >= 0
}
fn read_record(path){
    let result = nil
    try {
        let parsed = fs.read(path).parse_json()
        if record_valid(parsed) { result = parsed }
    } { result = nil }
    result
}
fn store_record(next){
    if !storageReady {
        ui.status.set_text("记录无法读取，已暂停保存。请先恢复有效的计划文件。")
        return false
    }
    next.revision = journal.revision + 1
    let target = "plans-a.json"
    if activeFile == target { target = "plans-b.json" }
    let written = false
    try {
        let text = next.to_json()
        fs.write(target, text)
        if fs.read(target) == text {
            let checked = read_record(target)
            if checked != nil { written = true }
        }
    } { written = false }
    if !written {
        ui.status.set_text("保存失败：未能写入并核验。上一份有效计划已保留，请检查存储后重试。")
        return false
    }
    journal = next
    activeFile = target
    return true
}
fn hide_candidates(){
    // Invalidate any outstanding assistant callback when its inputs/results
    // cease to be usable. A late callback must not lock a newer request.
    agentRequest += 1
    agentBusy = false
    candidates = []
    candidateStamp = ""
    agentChoice = -1
    agentStamp = ""
    ui.agent_result.set_text("先生成候选，再请系统 Agent 比较。")
    ui.choices.render()
}
fn invalidate(){
    hide_candidates()
    show_page(false)
    ui.status.set_text("条件已变化，请重新查找候选。已保存计划不变。")
    refresh_summary()
}
fn selection_stamp(){
    ui.date.text().trim() + "|" + currentDate + "|" + selectedSlot + "|" + ui.daily.text().trim() + "|" + ui.budget.text().trim() + "|" + ui.arrival.text().trim() + "|" + ui.request.text().trim() + "|" + ui.avoid_spicy.checked()
}
fn show_page(history){
    ui.selection.set_visible(!history)
    ui.history.set_visible(history)
    ui.results.set_visible(false)
    if history { ui.plans.render() }
}
fn refresh_summary(){
    let total = sum_meals(current_meals(), -1)
    let daily = money_value(ui.daily.text())
    let summary = currentDate + " · 已计划 ¥" + cash(total)
    if daily >= 0 {
        summary = summary + " · 剩余 ¥" + cash(daily - total)
    }
    ui.summary.set_text(summary)
    ui.tier_label.set_text("当前 A" + (selectedTier + 1) + " · 原档日预算 ¥" + cash(tiers[selectedTier]) + "（可改）")
    ui.slot_label.set_text("正在安排：" + slotNames[selectedSlot] + " · 确认会替换同日同餐次")
}
fn apply_slot(slot){
    selectedSlot = slot
    ui.budget.set_text(cash(limits[selectedTier][slot]))
    ui.arrival.set_text(defaultTimes[slot])
    invalidate()
}
fn apply_tier(tier){
    selectedTier = tier
    ui.daily.set_text(cash(tiers[tier]))
    ui.budget.set_text(cash(limits[tier][selectedSlot]))
    invalidate()
}
fn open_date(){
    let date = ui.date.text().trim()
    if !valid_date(date) { ui.status.set_text("请填写有效日期，例如 2026-10-03。") return }
    currentDate = date
    let i = day_index(journal, date)
    if i >= 0 {
        selectedTier = journal.days[i].tier
        ui.daily.set_text(cash(journal.days[i].daily_cents))
    } else { ui.daily.set_text(cash(tiers[selectedTier])) }
    ui.budget.set_text(cash(limits[selectedTier][selectedSlot]))
    hide_candidates()
    refresh_summary()
    ui.plans.render()
    ui.status.set_text("已打开 " + date + " 的餐饮计划。")
}
fn read_conditions(){
    if ui.date.text().trim() != currentDate || !valid_date(currentDate) {
        ui.status.set_text("日期已改动，请先点「打开日期」。") return nil
    }
    let daily = money_value(ui.daily.text())
    let budget = money_value(ui.budget.text())
    let arrival = clock_value(ui.arrival.text().trim())
    if daily < 0 || budget < 0 || arrival < 0 {
        ui.status.set_text("预算需为 1–500 元、最多两位小数；时间需为有效 HH:MM。") return nil
    }
    let request = ui.request.text().trim()
    if request.len() > 500 { ui.status.set_text("需求请控制在 500 字以内。") return nil }
    if regex("过敏|素食|清淡|高蛋白|不吃肉|不吃牛肉|不吃猪肉|不吃奶|不吃蛋|花生|海鲜", "").test(request) {
        ui.status.set_text("菜单无法可靠核验这类饮食限制。当前支持预算、到店时间和关键词避辣。") return nil
    }
    let other = sum_meals(current_meals(), selectedSlot)
    if other >= daily {
        ui.status.set_text("其他餐次已用完当前日预算，请增加预算或取消已有计划。") return nil
    }
    let avoid = ui.avoid_spicy.checked() || regex("不吃辣|不要辣|少辣|避辣|别太辣", "").test(request)
    {daily: daily cap: min(budget, daily - other) arrival: arrival avoid: avoid request: request}
}
fn find_candidates(){
    hide_candidates()
    let condition = read_conditions()
    if condition == nil { return }
    let stamp = selection_stamp()
    if stamp != lastSearch { searchCursor = 0 }
    lastSearch = stamp
    let stores = []
    let examined = 0
    while examined < allProducts.len() && candidates.len() < 3 {
        let idx = searchCursor % allProducts.len()
        searchCursor += 1
        examined += 1
        let p = allProducts[idx]
        if p.cents <= condition.cap && matches_meal(p) && open_at(p.business_hours, condition.arrival) {
            let duplicate = false
            for store in stores { if store == p.store { duplicate = true } }
            let spicy = regex("辣|麻|椒", "").test(p.name + " " + p.category)
            if !duplicate && (!condition.avoid || !spicy) {
                candidates.push(idx)
                stores.push(p.store)
            }
        }
    }
    candidateStamp = stamp
    ui.choices.render()
    if candidates.len() == 0 {
        ui.status.set_text("没有符合预算、时段和口味的候选，请调整条件。")
    } else {
        ui.selection.set_visible(false)
        ui.history.set_visible(false)
        ui.results.set_visible(true)
        ui.status.set_text("找到 " + candidates.len() + " 个候选 · 本餐可用 ¥" + cash(condition.cap) + "。再次查找可换一批。")
    }
}
fn prepare_day(daily){
    let next = journal.to_json().parse_json()
    let idx = day_index(next, currentDate)
    if idx < 0 {
        if next.days.len() >= 90 { ui.status.set_text("已保存 90 个日期，请先导出整理历史记录。") return nil }
        next.days.push({date: currentDate daily_cents: daily tier: selectedTier meals: []})
        idx = next.days.len() - 1
    }
    next.last_date = currentDate
    next.days[idx].daily_cents = daily
    next.days[idx].tier = selectedTier
    next
}
fn choose_meal(index){
    if candidateStamp == "" || candidateStamp != selection_stamp() {
        invalidate()
        return
    }
    if index < 0 || index >= candidates.len() { return }
    let condition = read_conditions()
    if condition == nil { return }
    let product_id = candidates[index]
    let p = allProducts[product_id]
    if p.cents > condition.cap { invalidate() return }
    let next = prepare_day(condition.daily)
    if next == nil { return }
    let d = day_index(next, currentDate)
    let kept = []
    for m in next.days[d].meals { if m.slot != selectedSlot { kept.push(m) } }
    kept.push({slot: selectedSlot product_id: product_id cents: p.cents name: p.name store: p.store hours: p.business_hours arrival: ui.arrival.text().trim() note: condition.request saved_at: time_now()})
    next.days[d].meals = kept
    if store_record(next) {
        hide_candidates()
        refresh_summary()
        show_page(true)
        ui.status.set_text("已保存并读回核验：" + slotNames[selectedSlot] + " · " + p.name + "。仅为计划，未下单。")
    }
}
fn ask_agent(){
    if agentBusy { return }
    if candidates.len() == 0 || candidateStamp == "" || candidateStamp != selection_stamp() {
        ui.agent_result.set_text("候选已失效，请重新查找。")
        return
    }
    let condition = read_conditions()
    if condition == nil {
        agentChoice = -1
        agentStamp = ""
        ui.agent_result.set_text("当前条件已不可用，请重新查找候选。")
        return
    }
    agentRequest += 1
    let requestId = agentRequest
    let stamp = candidateStamp
    let options = ""
    for candidateIndex in candidates.len() {
        let i = candidates[candidateIndex]
        let p = allProducts[i]
        options += "候选 " + (candidateIndex + 1) + ": id=" + i + "；" + p.name + "；¥" + cash(p.cents) + "；" + p.store + "；时段 " + p.business_hours + "。\n"
    }
    let prior = "无"
    for m in current_meals() { prior += "；" + slotNames[m.slot] + " " + m.name + " ¥" + cash(m.cents) }
    let prompt = "你是餐饮候选比较助手。只能比较给出的候选，不能编造价格、菜品、营业信息或营养过敏事实。\n"
        + "用户餐次：" + slotNames[selectedSlot] + "；日预算 ¥" + cash(money_value(ui.daily.text()))
        + "；本餐可用上限 ¥" + cash(condition.cap) + "；到店时间 " + ui.arrival.text()
        + "；用户需求：" + ui.request.text() + "；当天已计划：" + prior + "。\n"
        + "候选如下：\n" + options
        + "仅返回 JSON：{\"choice\":候选序号(从1开始，无法推荐则0),\"reason\":\"简短取舍理由\"}。不要提供其他文本。"
    agentChoice = -1
    agentStamp = ""
    ui.agent_result.set_text("正在请求 OctoSense 系统 Agent…")
    agentBusy = true
    host.request("octos.turn.start", {text: prompt}, fn(r){
        if requestId != agentRequest { return }
        agentBusy = false
        if stamp != candidateStamp || stamp != selection_stamp() {
            agentChoice = -1
            agentStamp = ""
            ui.agent_result.set_text("条件已变化；这次 Agent 结果已丢弃，请重新查找。")
            return
        }
        if !r.is_ok {
            agentChoice = -1
            agentStamp = ""
            ui.agent_result.set_text("系统 Agent 暂不可用：" + r.error + "。你仍可自行选择候选。")
            return
        }
        let answer = nil
        try { answer = r.data.text.parse_json() } { answer = nil }
        if !answer.is_object() {
            agentChoice = -1
            agentStamp = ""
            ui.agent_result.set_text("Agent 已回复，但建议格式无法核验。请自行查看候选。")
            return
        }
        let choice = -1
        try {
            let value = answer.choice
            if value.is_number() { choice = value }
        } { choice = -1 }
        if !(choice >= 0 && choice <= candidates.len() && choice == floor(choice)) {
            agentChoice = -1
            agentStamp = ""
            ui.agent_result.set_text("Agent 已回复，但建议格式无法核验。请自行查看候选。")
            return
        }
        if choice == 0 {
            agentChoice = -1
            agentStamp = ""
            ui.agent_result.set_text("Agent 没有选出合适候选；你仍可自行判断。")
            return
        }
        let reason = "未提供取舍理由"
        try {
            let value = answer.reason
            if value.is_string() { reason = value }
        } { reason = "未提供取舍理由" }
        if reason.len() > 300 { reason = "理由过长，已省略" }
        agentChoice = choice - 1
        agentStamp = stamp
        ui.agent_result.set_text("Agent 建议候选 " + choice + "：" + reason + "\n仅为建议；请核对信息并自行确认。")
        ui.choices.render()
    })
}
fn cancel_meal(slot){
    let d = day_index(journal, currentDate)
    if d < 0 { return }
    let next = journal.to_json().parse_json()
    let kept = []
    for m in next.days[d].meals { if m.slot != slot { kept.push(m) } }
    next.days[d].meals = kept
    next.last_date = currentDate
    if store_record(next) {
        hide_candidates()
        ui.daily.set_text(cash(next.days[d].daily_cents))
        refresh_summary()
        ui.plans.render()
        ui.status.set_text("已取消" + slotNames[slot] + "，计划金额已更新并核验。")
    }
}
fn edit_meal(slot){
    apply_slot(slot)
    for m in current_meals() {
        if m.slot == slot { ui.arrival.set_text(m.arrival) ui.request.set_text(m.note) }
    }
    show_page(false)
    ui.status.set_text("正在修改" + slotNames[slot] + "。确认新候选前，旧计划继续保留。")
}
fn save_budget(){
    if ui.date.text().trim() != currentDate { ui.status.set_text("请先打开输入的日期。") return }
    let daily = money_value(ui.daily.text())
    if daily < 0 { ui.status.set_text("日预算需为 1–500 元、最多两位小数。") return }
    if daily < sum_meals(current_meals(), -1) { ui.status.set_text("新预算低于已计划金额，请先修改或取消餐次。") return }
    let next = prepare_day(daily)
    if next == nil { return }
    if store_record(next) { invalidate() ui.status.set_text("日预算已保存并读回核验。") }
}
fn boot(){
    let a = nil
    let b = nil
    let existsA = fs.exists("plans-a.json")
    let existsB = fs.exists("plans-b.json")
    if existsA { a = read_record("plans-a.json") }
    if existsB { b = read_record("plans-b.json") }
    if a != nil { journal = a activeFile = "plans-a.json" }
    if b != nil { if b.revision > journal.revision { journal = b activeFile = "plans-b.json" } }
    currentDate = today()
    if activeFile != "" { currentDate = journal.last_date }
    ui.date.set_text(currentDate)
    show_page(false)
    open_date()
    if (existsA || existsB) && activeFile == "" {
        storageReady = false
        ui.status.set_text("记录损坏或无法读取，已暂停保存，原文件保持不变。")
    } else {
        if (existsA && a == nil) || (existsB && b == nil) { ui.status.set_text("一份记录不可用，已恢复另一份有效记录。请核对计划。") }
        else { ui.status.set_text("本地规划已就绪。先查找候选，再确认保存。") }
    }
}

start_timeout(0.05, || boot())
let Action = ButtonFlat{height: 34 padding: Inset{left: 10 right: 10}
    draw_bg +: {color: #xe9edff color_hover: #xdce3ff color_down: #xcbd6ff border_radius: 8.0 border_size: 0.0}
    draw_text +: {color: blue color_hover: blue color_down: blue}}
let Field = TextInput{width: Fill height: 36
    draw_bg +: {color: #xffffff color_hover: #xffffff color_focus: #xffffff color_empty: #xffffff border_radius: 7.0}
    draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: muted color_empty_hover: muted}}
SolidView{width: Fill height: Fill flow: Down padding: 14 spacing: 8 draw_bg.color: #xf5f7fc
    Label{text: "OctoDining · 今晚吃什么" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 22}}
    Label{text: "让预算有限的人，也能好好吃饭" draw_text.color: muted draw_text.text_style.font_size: 12}
    View{width: Fill height: Fit flow: Right spacing: 8
        date := Field{text: "" empty_text: "YYYY-MM-DD" on_change: |text| invalidate()}
        open_day := Action{text: "打开日期" on_click: || open_date()}
    }
    summary := Label{width: Fill text: "正在读取计划…" draw_text.color: ink draw_text.text_style.font_size: 13}
    View{width: Fill height: Fit flow: Right spacing: 8
        tab_choose := Action{width: Fill text: "安排餐饮" on_click: || show_page(false)}
        tab_history := Action{width: Fill text: "查看计划" on_click: || show_page(true)}
    }
    selection := ScrollYView{width: Fill height: Fill flow: Down spacing: 8
        View{width: Fill height: Fit flow: Right spacing: 4
            a1 := Action{width: Fill text: "A1" on_click: || apply_tier(0)}
            a2 := Action{width: Fill text: "A2" on_click: || apply_tier(1)}
            a3 := Action{width: Fill text: "A3" on_click: || apply_tier(2)}
            a4 := Action{width: Fill text: "A4" on_click: || apply_tier(3)}
            a5 := Action{width: Fill text: "A5" on_click: || apply_tier(4)}
            a6 := Action{width: Fill text: "A6" on_click: || apply_tier(5)}
        }
        tier_label := Label{text: "A3" draw_text.color: muted draw_text.text_style.font_size: 12}
        View{width: Fill height: Fit flow: Right spacing: 6
            breakfast := Action{width: Fill text: "早餐" on_click: || apply_slot(0)}
            lunch := Action{width: Fill text: "午餐" on_click: || apply_slot(1)}
            dinner := Action{width: Fill text: "晚餐" on_click: || apply_slot(2)}
        }
        slot_label := Label{text: "晚餐" draw_text.color: muted draw_text.text_style.font_size: 12}
        View{width: Fill height: Fit flow: Right spacing: 8
            View{width: Fill height: Fit flow: Down spacing: 3
                Label{text: "日预算（元）" draw_text.color: muted draw_text.text_style.font_size: 12}
                daily := Field{text: "32.00" on_change: |text| invalidate()}
            }
            View{width: Fill height: Fit flow: Down spacing: 3
                Label{text: "本餐上限（元）" draw_text.color: muted draw_text.text_style.font_size: 12}
                budget := Field{text: "14.00" on_change: |text| invalidate()}
            }
            View{width: Fill height: Fit flow: Down spacing: 3
                Label{text: "到店时间" draw_text.color: muted draw_text.text_style.font_size: 12}
                arrival := Field{text: "18:30" on_change: |text| invalidate()}
            }
        }
        request := Field{text: "" empty_text: "口味需求，例如：别太辣" on_change: |text| invalidate()}
        avoid_spicy := CheckBox{text: "关键词避辣（不保证过敏原或辣度）" on_click: |active| invalidate()}
        View{width: Fill height: Fit flow: Right spacing: 8
            find := Action{width: Fill text: "查找 / 换一批" on_click: || find_candidates()}
            save_daily := Action{text: "保存日预算" on_click: || save_budget()}
        }
        Label{width: Fill text: "单餐上限与每日总预算同时生效。已有餐次会计入剩余金额。" draw_text.color: muted draw_text.text_style.font_size: 12}
    }
    results := View{width: Fill height: Fill flow: Down spacing: 10
        View{width: Fill height: Fit flow: Right spacing: 8
            Action{text: "调整条件" on_click: || show_page(false)}
            next_batch := Action{text: "换一批候选" on_click: || find_candidates()}
        }
        View{width: Fill height: Fit flow: Down spacing: 5
            ask_agent := Action{text: "让 OctoSense Agent 比较" on_click: || ask_agent()}
            agent_result := Label{width: Fill text: "先生成候选，再请系统 Agent 比较。" draw_text.color: blue draw_text.text_style.font_size: 12}
        }
        choices := ScrollYView{width: Fill height: Fill flow: Down spacing: 10 on_render: || {
            if candidates.len() == 0 { Label{width: Fill text: "填写条件后查找候选。价格和时段来自菜单快照。" draw_text.color: muted draw_text.text_style.font_size: 13} }
            for i in candidates.len() {
                let p = allProducts[candidates[i]]
                View{width: Fill height: Fit flow: Down spacing: 5
                    Label{width: Fill text: p.name + " · ¥" + cash(p.cents) draw_text.color: ink draw_text.text_style.font_size: 14}
                    Label{width: Fill text: p.store + " · " + p.business_hours draw_text.color: muted draw_text.text_style.font_size: 12}
                    if agentChoice == i && agentStamp == candidateStamp { Label{width: Fill text: "OctoSense Agent 建议" draw_text.color: blue draw_text.text_style.font_size: 12} }
                    Action{text: "确认候选 " + (i + 1) on_click: || choose_meal(i)}
                }
            }
        }}
    }
    history := View{width: Fill height: Fill flow: Down spacing: 8
        Label{width: Fill text: "每个日期、每个餐次保留一个已确认计划。修改时旧计划保留至新候选确认。" draw_text.color: muted draw_text.text_style.font_size: 13}
        plans := ScrollYView{width: Fill height: Fill flow: Down spacing: 14 on_render: || {
            let meals = current_meals()
            if meals.len() == 0 { Label{text: "这一天还没有已确认计划。" draw_text.color: muted} }
            for m in meals {
                View{width: Fill height: Fit flow: Down spacing: 6
                    Label{width: Fill text: slotNames[m.slot] + " · " + m.name + " · ¥" + cash(m.cents) draw_text.color: ink draw_text.text_style.font_size: 15}
                    Label{width: Fill text: m.store + " · 到店 " + m.arrival draw_text.color: muted draw_text.text_style.font_size: 12}
                    View{width: Fill height: Fit flow: Right spacing: 8
                        Action{text: "修改" + slotNames[m.slot] on_click: || edit_meal(m.slot)}
                        Action{text: "取消" + slotNames[m.slot] on_click: || cancel_meal(m.slot)}
                    }
                }
            }
        }}
    }
    status := Label{width: Fill text: "正在启动…" draw_text.color: blue draw_text.text_style.font_size: 13}
    Label{width: Fill text: "金额为计划开销，未下单。菜单非实时；日期请按需要核对。" draw_text.color: muted draw_text.text_style.font_size: 11}
}
